<Window x:Class="CadenceStudio.App.WindowVisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Cadence Studio — Window Visualizer"
        Width="1180" Height="720" MinWidth="640" MinHeight="420"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" ShowInTaskbar="True" KeyDown="Window_KeyDown"
        MouseMove="Window_MouseMove" SizeChanged="VisualizerWindow_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <!-- Only the first 58px is draggable; interactive buttons explicitly opt back in. -->
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- All controls below are pop-out-local. No shared resources are modified. -->
        <Style x:Key="VisualizerChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Shell" CornerRadius="9" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="FocusOutline" CornerRadius="9" BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Pinned">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Close"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Shell" Property="Background" Value="#664A2430"/>
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#AD5960"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource PremiumButtonPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusOutline" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VisualizerPinButtonStyle" TargetType="Button" BasedOn="{StaticResource VisualizerChromeButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Tag" Value="Pinned"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Pop-out-only preset selector: icon face, unchanged native ComboBox menu and selection handling. -->
        <Style x:Key="VisualizerPresetIconComboStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource CadenceUnifiedComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="IconToggle" ClickMode="Press" Focusable="False"
                                          shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid SnapsToDevicePixels="True">
                                            <Border x:Name="ButtonSurface" CornerRadius="9" Background="Transparent"
                                                    BorderBrush="Transparent" BorderThickness="1"/>
                                            <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <!-- Sparkles: center star plus two small glints. -->
                                                    <Path Data="M 12,3 L 13.7,9.7 L 20.4,11.4 L 13.7,13.1 L 12,19.8 L 10.3,13.1 L 3.6,11.4 L 10.3,9.7 Z"
                                                          Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6"
                                                          StrokeLineJoin="Round" Fill="Transparent"/>
                                                    <Path Data="M 19,2.5 L 19.7,4.3 L 21.5,5 L 19.7,5.7 L 19,7.5 L 18.3,5.7 L 16.5,5 L 18.3,4.3 Z"
                                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"
                                                          StrokeLineJoin="Round" Fill="Transparent"/>
                                                    <Path Data="M 5,17 L 5.6,18.4 L 7,19 L 5.6,19.6 L 5,21 L 4.4,19.6 L 3,19 L 4.4,18.4 Z"
                                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.1"
                                                          StrokeLineJoin="Round" Fill="Transparent"/>
                                                </Canvas>
                                            </Viewbox>
                                            <Border x:Name="FocusRing" CornerRadius="9" BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource PremiumButtonPressedBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-242" VerticalOffset="8"
                                   AllowsTransparency="True" Focusable="False" StaysOpen="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Width="276" Style="{StaticResource CadenceMenuChromeStyle}">
                                    <StackPanel>
                                        <TextBlock Text="VISUALIZER PRESETS" Style="{StaticResource CadenceMenuHeadingStyle}"/>
                                        <Border Style="{StaticResource CadenceMenuRuleStyle}"/>
                                        <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto" MaxHeight="260">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Border x:Name="KeyboardFocusRing" CornerRadius="9" BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="KeyboardFocusRing" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Previous/next are quiet, touchable glyphs; only play/pause is a colored disk. -->
        <Style x:Key="VisualizerTransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Shell" CornerRadius="11" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="FocusOutline" CornerRadius="11" BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="2" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource PremiumButtonPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusOutline" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VisualizerHeroPlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Ellipse x:Name="Disk" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="FocusOutline" Stroke="{DynamicResource TextPrimaryBrush}"
                                     StrokeThickness="2" Margin="2" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disk" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Disk" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Edge-to-edge presentation; NO full-width title or transport bars. -->
    <Grid ClipToBounds="True" Background="{DynamicResource WindowBrush}">
        <!-- The entire scene covers the window; only its outer edges crop, never its central focal geometry. -->
        <Viewbox Stretch="UniformToFill" StretchDirection="Both"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
            <Grid x:Name="VisualizerRoot" Width="1180" Height="620" ClipToBounds="True" Opacity="1">
                    <Grid.Background>
                        <RadialGradientBrush Center="0.5,0.47" GradientOrigin="0.5,0.47" RadiusX="0.78" RadiusY="0.92">
                            <GradientStop Color="{DynamicResource VisualizerAtmosphereColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource SurfaceRaisedColor}" Offset="0.43"/>
                            <GradientStop Color="{DynamicResource WindowColor}" Offset="1"/>
                        </RadialGradientBrush>
                    </Grid.Background>
        <!-- cinematic atmospheric color fields -->
        <Ellipse Width="920" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.28">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource VisualizerAtmosphereColor}" Offset="0"/><GradientStop Color="{DynamicResource AccentSoftColor}" Offset="0.48"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            <Ellipse.Effect><BlurEffect Radius="70"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="AtmosphereHaloA" Width="1120" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.18">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource VisualizerBand1Color}" Offset="0"/><GradientStop Color="#00101018" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            <Ellipse.Effect><BlurEffect Radius="95"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="AtmosphereHaloB" Width="760" Height="760" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.16">
            <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource VisualizerBand6Color}" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            <Ellipse.Effect><BlurEffect Radius="82"/></Ellipse.Effect>
        </Ellipse>
        <Canvas IsHitTestVisible="False" Opacity="0.72">
            <Ellipse x:Name="ParticleA" Width="5" Height="5" Fill="{DynamicResource VisualizerBand6Brush}" Canvas.Left="110" Canvas.Top="128"/>
            <Ellipse x:Name="ParticleB" Width="3" Height="3" Fill="{DynamicResource VisualizerCoreBrush}" Canvas.Right="145" Canvas.Top="172"/>
            <Ellipse x:Name="ParticleC" Width="4" Height="4" Fill="{DynamicResource VisualizerBand5Brush}" Canvas.Left="245" Canvas.Bottom="150"/>
            <Ellipse x:Name="ParticleD" Width="3" Height="3" Fill="{DynamicResource VisualizerBand3Brush}" Canvas.Right="260" Canvas.Bottom="132"/>
            <Ellipse x:Name="ParticleE" Width="2" Height="2" Fill="White" Canvas.Left="50" Canvas.Top="290"/>
            <Ellipse x:Name="ParticleF" Width="2" Height="2" Fill="White" Canvas.Right="68" Canvas.Top="248"/>
        </Canvas>
        <Ellipse x:Name="OrbitOuter" Width="570" Height="570" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource VisualizerBand1Brush}" StrokeThickness="2" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform></Ellipse>
        <Ellipse x:Name="OrbitMiddle" Width="480" Height="480" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="2,7" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform></Ellipse>
        <Ellipse x:Name="OrbitInner" Width="385" Height="385" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource VisualizerBand5Brush}" StrokeThickness="1.5" StrokeDashArray="5,3" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform></Ellipse>
        <Ellipse x:Name="CelestialDottedRing" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#55E6B65D" StrokeThickness="2" StrokeDashArray="1,4"/>

        <!-- orbital nodes -->
        <Ellipse Width="12" Height="12" Fill="{DynamicResource VisualizerCoreBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,58,0,0"><Ellipse.Effect><DropShadowEffect Color="{DynamicResource VisualizerCoreColor}" BlurRadius="18" ShadowDepth="0"/></Ellipse.Effect></Ellipse>
        <Ellipse Width="8" Height="8" Fill="{DynamicResource VisualizerBand6Brush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="235,0,0,0"/>
        <Ellipse Width="8" Height="8" Fill="{DynamicResource VisualizerBand6Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,235,0"/>

        <!-- alternate preset layers: each preset has its own geometry and atmosphere -->
        <Grid x:Name="AuroraCascadeLayer" Visibility="Collapsed" IsHitTestVisible="False">
            <Ellipse Width="980" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.42">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource VisualizerBand3Color}" Offset="0"/><GradientStop Color="{DynamicResource VisualizerBand5Color}" Offset="0.48"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="85"/></Ellipse.Effect>
            </Ellipse>
            <Canvas ClipToBounds="True">
                <Path x:Name="AuroraRibbonA" Data="M 0,170 C 220,40 420,290 650,120 C 860,-20 1040,210 1280,65" Stroke="{DynamicResource VisualizerBand3Brush}" StrokeThickness="46" Opacity="0.38" Fill="Transparent"><Path.Effect><BlurEffect Radius="26"/></Path.Effect></Path>
                <Path x:Name="AuroraRibbonB" Data="M 0,280 C 210,410 430,95 690,260 C 920,410 1090,115 1320,310" Stroke="{DynamicResource VisualizerBand5Brush}" StrokeThickness="34" Opacity="0.34" Fill="Transparent"><Path.Effect><BlurEffect Radius="22"/></Path.Effect></Path>
                <Path x:Name="AuroraRibbonC" Data="M 0,350 C 250,190 430,470 710,300 C 930,160 1100,380 1320,210" Stroke="{DynamicResource VisualizerBand6Brush}" StrokeThickness="18" Opacity="0.30" Fill="Transparent"><Path.Effect><BlurEffect Radius="16"/></Path.Effect></Path>
            </Canvas>
        </Grid>

        <Grid x:Name="GlassHorizonLayer" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.66">
            <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="155,92,155,126" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid Width="760" Height="430" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><RotateTransform x:Name="GlassHorizonRotation"/></Grid.RenderTransform>
                    <Ellipse Width="650" Height="350" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#08000000" Stroke="{DynamicResource VisualizerBand5Brush}" StrokeThickness="1" Opacity="0.50"/>
                    <Canvas Width="700" Height="390" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Polygon x:Name="GlassShardA" Points="120,330 245,82 330,325" Stroke="{DynamicResource VisualizerBand6Brush}" StrokeThickness="1.6">
                            <Polygon.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0EFFFFFF" Offset="0"/><GradientStop Color="{DynamicResource VisualizerBand6Color}" Offset="0.55"/><GradientStop Color="#02000000" Offset="1"/></LinearGradientBrush></Polygon.Fill>
                        </Polygon>
                        <Polygon x:Name="GlassShardB" Points="270,345 385,105 480,345" Stroke="{DynamicResource VisualizerBand4Brush}" StrokeThickness="1.5">
                            <Polygon.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#12FFFFFF" Offset="0"/><GradientStop Color="{DynamicResource VisualizerBand4Color}" Offset="0.58"/><GradientStop Color="#02000000" Offset="1"/></LinearGradientBrush></Polygon.Fill>
                        </Polygon>
                        <Polygon x:Name="GlassShardC" Points="445,330 555,70 635,330" Stroke="{DynamicResource VisualizerBand5Brush}" StrokeThickness="1.6">
                            <Polygon.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0CFFFFFF" Offset="0"/><GradientStop Color="{DynamicResource VisualizerBand5Color}" Offset="0.60"/><GradientStop Color="#02000000" Offset="1"/></LinearGradientBrush></Polygon.Fill>
                        </Polygon>
                        <Line X1="105" Y1="338" X2="645" Y2="338" Stroke="{DynamicResource VisualizerCoreBrush}" StrokeThickness="2" Opacity="0.72"/>
                        <Line X1="190" Y1="118" X2="570" Y2="315" Stroke="#32FFFFFF" StrokeThickness="1"/>
                        <Line X1="300" Y1="310" X2="575" Y2="100" Stroke="#24FFFFFF" StrokeThickness="1"/>
                    </Canvas>
                </Grid>
            </Viewbox>
        </Grid>

        <Grid x:Name="InfiniteWindowsLayer" Visibility="Collapsed" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
            <Border Width="860" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource VisualizerBand1Brush}" BorderThickness="2" Opacity="0.28"/>
            <Border Width="700" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource VisualizerBand2Brush}" BorderThickness="2" Opacity="0.38"/>
            <Border Width="540" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource VisualizerBand4Brush}" BorderThickness="2" Opacity="0.52"/>
            <Border Width="380" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource VisualizerBand5Brush}" BorderThickness="3" Opacity="0.68"/>
            <Border Width="220" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{DynamicResource VisualizerCoreBrush}" BorderThickness="4" Opacity="0.92"><Border.Effect><DropShadowEffect Color="{DynamicResource VisualizerCoreColor}" BlurRadius="34" ShadowDepth="0"/></Border.Effect></Border>
        </Grid>

        <!-- spectrum stage -->
        <Grid x:Name="SpectrumStage" Margin="42,58,42,92" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <ItemsControl Grid.Row="0" ItemsSource="{Binding VisualizerBars}" VerticalAlignment="Bottom" Height="230" Opacity="0.34" IsHitTestVisible="False">
                <ItemsControl.Effect><BlurEffect Radius="11"/></ItemsControl.Effect>
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><Border Height="{Binding ExpandedHeight}" Margin="1,0" VerticalAlignment="Bottom" Background="{Binding ExpandedFill}" CornerRadius="5"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl Grid.Row="0" ItemsSource="{Binding VisualizerBars}" VerticalAlignment="Bottom" Height="230">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="{Binding ExpandedHeight}" Margin="2,0" VerticalAlignment="Bottom" Background="{Binding ExpandedFill}" CornerRadius="3,3,1,1">
                            <Border.Effect><DropShadowEffect Color="#AAFFFFFF" BlurRadius="12" ShadowDepth="0" Opacity="0.32"/></Border.Effect>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Grid.Row="1" Height="2" Background="{DynamicResource VisualizerCoreBrush}" CornerRadius="1"><Border.Effect><DropShadowEffect Color="{DynamicResource VisualizerCoreColor}" BlurRadius="18" ShadowDepth="0"/></Border.Effect></Border>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding VisualizerBars}" VerticalAlignment="Top" Height="170" Opacity="0.42" RenderTransformOrigin="0.5,0.5">
                <ItemsControl.RenderTransform><ScaleTransform ScaleY="-0.68"/></ItemsControl.RenderTransform>
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate><Border Height="{Binding ExpandedHeight}" Margin="2,0" VerticalAlignment="Top" Background="{Binding ExpandedFill}" CornerRadius="1,1,3,3"><Border.Effect><BlurEffect Radius="2"/></Border.Effect></Border></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- central energy core -->
        <Grid x:Name="CoreShell" Width="230" Height="230" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><TransformGroup><ScaleTransform/><RotateTransform/></TransformGroup></Grid.RenderTransform>
            <Ellipse Stroke="#90F5D58C" StrokeThickness="2" Margin="4"/>
            <Ellipse Stroke="#60B7B9FF" StrokeThickness="1" Margin="30" StrokeDashArray="3,4"/>
            <Polygon x:Name="CoreHex" Points="115,38 180,76 180,152 115,190 50,152 50,76" Stroke="{DynamicResource VisualizerCoreBrush}" StrokeThickness="2.2" Fill="#142A2637"/>
            <Polygon x:Name="CoreDiamond" Points="115,54 163,114 115,174 67,114" Stroke="{DynamicResource VisualizerBand6Brush}" StrokeThickness="1.4" Fill="#102E3760"/>
            <Line X1="50" Y1="76" X2="180" Y2="152" Stroke="#70FFFFFF"/>
            <Line X1="180" Y1="76" X2="50" Y2="152" Stroke="#70FFFFFF"/>
            <Ellipse x:Name="CoreGlow" Width="24" Height="24" Fill="{DynamicResource VisualizerBand6Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"><Ellipse.Effect><DropShadowEffect Color="{DynamicResource VisualizerCoreColor}" BlurRadius="34" ShadowDepth="0" Opacity="1"/></Ellipse.Effect></Ellipse>
        </Grid>

        <!-- reflective platform -->
        <Ellipse x:Name="ReflectionPlatform" Width="520" Height="90" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,45" Stroke="#70F5C96C" StrokeThickness="2" Fill="#0EFFFFFF"/>
        <Ellipse x:Name="ReflectionInner" Width="390" Height="58" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,57" Stroke="#50FFFFFF" StrokeThickness="1"/>

            </Grid>
        </Viewbox>

        <!-- Left and right are separate floating chips; uncovered caption space remains draggable. -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="46" Margin="14,12,14,0"
              Panel.ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Non-interactive glass brand card doubles as the window's drag affordance. -->
            <Grid Grid.Column="0" Width="184" Height="46" IsHitTestVisible="False">
                <Border Background="{DynamicResource SurfaceRaisedBrush}" Opacity="0.84" CornerRadius="13"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"/>
                <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <Image Source="Assets/cadence-studio-icon-256.png" Width="25" Height="25" Stretch="Uniform" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CADENCE" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="  /  VISUALIZER" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <TextBlock x:Name="PresetCreditText" Text="Inspired by TMWrath" FontSize="9.5"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="2" Height="44" VerticalAlignment="Center">
                <Border Background="{DynamicResource SurfaceRaisedBrush}" Opacity="0.86" CornerRadius="13"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                    <ComboBox x:Name="PresetSelector" Margin="0,0,5,0"
                              Style="{StaticResource VisualizerPresetIconComboStyle}"
                              SelectionChanged="PresetSelector_SelectionChanged"
                              ToolTip="{Binding WindowVisualizerPresetLabel, StringFormat='Visualizer preset: {0} (Left / Right to cycle)'}"
                              AutomationProperties.Name="Choose visualizer preset"
                              AutomationProperties.HelpText="{Binding WindowVisualizerPresetLabel}"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ComboBoxItem Content="Celestial Resonance" Tag="CelestialResonance"/>
                        <ComboBoxItem Content="Aurora Cascade" Tag="AuroraCascade"/>
                        <ComboBoxItem Content="Glass Horizon" Tag="GlassHorizon"/>
                        <ComboBoxItem Content="Infinite Windows" Tag="InfiniteWindows"/>
                    </ComboBox>
                    <Button x:Name="PinButton" Style="{StaticResource VisualizerPinButtonStyle}" Click="Pin_Click"
                            ToolTip="Always on top" AutomationProperties.Name="Toggle always on top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 8,3 L 16,3 L 15,8 L 18,11 L 18,13 L 6,13 L 6,11 L 9,8 Z M 12,13 L 12,21"/>
                    </Button>
                    <Button Style="{StaticResource VisualizerChromeButtonStyle}" Click="Fullscreen_Click"
                            ToolTip="Fullscreen / restore (F11)" AutomationProperties.Name="Toggle fullscreen"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 9,3 L 3,3 L 3,9 M 15,3 L 21,3 L 21,9 M 21,15 L 21,21 L 15,21 M 9,21 L 3,21 L 3,15"/>
                    </Button>
                    <Button Style="{StaticResource VisualizerChromeButtonStyle}" Tag="Close" Click="Close_Click"
                            ToolTip="Close visualizer" AutomationProperties.Name="Close visualizer"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 4,4 L 20,20 M 20,4 L 4,20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- A single coordinated glass dock. Compact: metadata gets the full left side,
             playback remains at right, technical readout disappears. Wide: transport
             moves to center and the readout returns at right. No overlapping cards. -->
        <Grid x:Name="ControlsPanel" VerticalAlignment="Bottom" Height="78" Margin="14,0,14,12"
              Opacity="0" Panel.ZIndex="11">
            <Border Background="{DynamicResource SurfaceRaisedBrush}" Opacity="0.88" CornerRadius="16"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.24"/>
                </Border.Effect>
            </Border>
            <Grid Margin="12,7" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="0"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="DockStatusColumn" Width="0" MinWidth="0"/>
                </Grid.ColumnDefinitions>

                <!-- Album cover and two clean metadata lines; title receives all free
                     space at compact widths, instead of being limited to half the footer. -->
                <Grid Grid.Column="0" MinWidth="0" Margin="0,0,9,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="0"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,11,0" ClipToBounds="True"
                            Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1" VerticalAlignment="Center">
                        <Grid>
                            <Image Source="Assets/cadence-studio-icon-256.png" Width="31" Height="31" Stretch="Uniform"/>
                            <Border>
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding NowPlayingArtwork, Converter={StaticResource AlbumArtConverter}}"
                                                Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True">
                        <TextBlock Text="{Binding NowPlayingTitle}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" ToolTip="{Binding NowPlayingTitle}"/>
                        <TextBlock Text="{Binding NowPlayingArtist}" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- No nested black capsule: the three controls share the same glass dock. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Button Style="{StaticResource VisualizerTransportButtonStyle}" Command="{Binding PreviousCommand}"
                            ToolTip="Previous track" AutomationProperties.Name="Previous track">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}"
                              Data="M 3,3 L 6,3 L 6,21 L 3,21 Z M 19,3 L 8,12 L 19,21 Z"/>
                    </Button>
                    <Button Style="{StaticResource VisualizerHeroPlayButtonStyle}" Command="{Binding TogglePlaybackCommand}"
                            ToolTip="Play or pause (Space)" AutomationProperties.Name="Play or pause">
                        <Grid Width="20" Height="20">
                            <Path Fill="{DynamicResource CadenceOnAccentBrush}" Data="M 6,2 L 23,12 L 6,22 Z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaybackPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Grid Width="16" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaybackPlaying}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Rectangle Width="5" RadiusX="1" RadiusY="1" Fill="{DynamicResource CadenceOnAccentBrush}"
                                           HorizontalAlignment="Left"/>
                                <Rectangle Width="5" RadiusX="1" RadiusY="1" Fill="{DynamicResource CadenceOnAccentBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource VisualizerTransportButtonStyle}" Command="{Binding NextCommand}"
                            ToolTip="Next track" AutomationProperties.Name="Next track">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}"
                              Data="M 16,3 L 19,3 L 19,21 L 16,21 Z M 5,3 L 16,12 L 5,21 Z"/>
                    </Button>
                </StackPanel>

                <!-- The readout only occupies a third column when there is genuinely
                     room for it; the resize handler updates its visibility and width. -->
                <StackPanel x:Name="DockTechnicalStatus" Grid.Column="2" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,3,0"
                            IsHitTestVisible="False">
                    <TextBlock Text="20 Hz — 20 kHz" FontSize="10" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding WindowVisualizerQualityLabel}" FontSize="11"
                               Margin="0,3,0,0" HorizontalAlignment="Right"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
