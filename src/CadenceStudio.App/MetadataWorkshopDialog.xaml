<Window x:Class="CadenceStudio.App.MetadataWorkshopDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Metadata Workshop" Width="1040" Height="760" MinWidth="920" MinHeight="680"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppBodyFontFamily}" FontSize="{DynamicResource AppBodyFontSize}"
        FontWeight="Medium" ShowInTaskbar="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppBodyFontSize}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionOpacity" Value="0.55" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxShell"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="TextBoxShell" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TextBoxShell" Property="BorderBrush" Value="{DynamicResource ControlActiveBrush}" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkshopComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppBodyFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboShell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="SelectedContent"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      IsHitTestVisible="False" />
                                    <TextBlock x:Name="LoadingPlaceholder"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Text="Loading release candidates…"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold"
                                               Visibility="Collapsed"
                                               IsHitTestVisible="False" />
                                    <Border Grid.Column="1" Margin="0,4,4,4" CornerRadius="10"
                                            Background="{DynamicResource PremiumCardBrush}"
                                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                        <TextBlock Text="⌄" FontFamily="Segoe UI Symbol" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent" BorderThickness="0" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="440"
                                        Margin="0,7,0,0"
                                        Background="{DynamicResource PremiumMenuBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="15" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="8" Opacity="0.78" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="3" CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="{DynamicResource ControlActiveBrush}" />
                                <Setter TargetName="ComboShell" Property="Background" Value="{DynamicResource PremiumButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ComboShell" Property="Background" Value="{DynamicResource PremiumButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="SelectedContent" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="LoadingPlaceholder" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ComboShell" Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboShell" Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="18" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Style="{StaticResource PremiumDialogChromeStyle}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" CornerRadius="18,18,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                        <TextBlock Text="Metadata Workshop" FontSize="14" FontWeight="Bold"/>
                        <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="12,0,0,0"><TextBlock Text="SAFE REVIEW" FontSize="9" FontWeight="Bold"/></Border>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseWindowButtonStyle}" Content="×" Click="Close_Click"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource SecondaryWorkspaceCardStyle}" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="68" Height="68" CornerRadius="12" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Image x:Name="ArtworkImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FileNameText" FontFamily="{DynamicResource AppDisplayFontFamily}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="FilePathText" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                            <TextBlock x:Name="MatchStatusText" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0"/>
                            <TextBlock x:Name="ProposalReleaseText" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,12,0"/>
                            <TextBlock Text="MusicBrainz release candidate" Style="{StaticResource CaptionStyle}" Margin="0,8,12,4"/>
                            <ComboBox x:Name="ReleaseCandidateBox"
                                      Style="{StaticResource WorkshopComboBoxStyle}"
                                      MinWidth="420" MaxWidth="650" HorizontalAlignment="Left"
                                      IsEditable="False"
                                      TextSearch.TextPath="DisplayLabel"
                                      DisplayMemberPath="DisplayLabel"
                                      SelectionChanged="ReleaseCandidateBox_SelectionChanged">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource PremiumComboBoxItemStyle}" />
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentPillButtonStyle}" Content="Tag full album" Click="OpenAlbumWorkshop_Click" Margin="0,0,0,8" ToolTip="Review and write every supported audio file in this album folder"/>
                            <Button x:Name="SearchProposalButton" Style="{StaticResource PillButtonStyle}" Content="Reload selected release + artwork" Click="SearchProposal_Click" Margin="0,0,0,8"/>
                            <Button x:Name="ApplyProposalButton" Style="{StaticResource AccentPillButtonStyle}" Content="Apply proposal to fields" Click="UseProposal_Click" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource PillButtonStyle}" Content="Restore current values" Click="RestoreCurrent_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SecondaryWorkspaceCardStyle}" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Current file tags" Style="{StaticResource PanelTitleStyle}"/>
                                <TextBlock Text="Read-only snapshot from the selected audio file." Style="{StaticResource CaptionStyle}" Margin="0,4,0,16"/>
                                <Grid x:Name="CurrentFieldsGrid"/>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Artwork health" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ArtworkHealthText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SecondaryWorkspaceCardStyle}" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Proposed / editable tags" Style="{StaticResource PanelTitleStyle}"/>
                                <TextBlock Text="Nothing is written until you explicitly approve below." Style="{StaticResource CaptionStyle}" Margin="0,4,0,10"/>
                                <Border x:Name="ProposalWarningBorder" Background="#331F1720" BorderBrush="#A97D8290" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Proposal conflict warning" FontWeight="Bold"/>
                                        <TextBlock x:Name="ProposalWarningText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Title" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/><TextBox x:Name="TitleBox" Grid.Row="0" Grid.Column="1"/>
                                    <TextBlock Grid.Row="1" Text="Artist" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/><TextBox x:Name="ArtistBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="2" Text="Album artist" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/><TextBox x:Name="AlbumArtistBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="3" Text="Album" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/><TextBox x:Name="AlbumBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="4" Text="Genre" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/><TextBox x:Name="GenreBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="5" Text="Year" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/><TextBox x:Name="YearBox" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0"/>
                                    <TextBlock Grid.Row="6" Text="Track / total" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="6" Grid.Column="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="TrackNumberBox"/><TextBox x:Name="TrackCountBox" Grid.Column="2"/></Grid>
                                    <TextBlock Grid.Row="7" Text="Disc / total" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="7" Grid.Column="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="DiscNumberBox"/><TextBox x:Name="DiscCountBox" Grid.Column="2"/></Grid>
                                    <CheckBox x:Name="EmbedArtworkCheck" Style="{StaticResource PremiumAuditCheckBoxStyle}" Grid.Row="8" Grid.Column="1" Margin="0,14,0,0" Content="Embed available artwork into the file" FontWeight="SemiBold"/>
                                </Grid>
                                <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                                    <StackPanel><TextBlock Text="Backup policy" FontWeight="SemiBold"/><TextBlock Text="Cadence creates a timestamped copy before every write and verifies the saved tags afterward." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="Review the proposal before writing." Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource PillButtonStyle}" Content="Cancel" Click="Close_Click" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource AccentPillButtonStyle}" Content="Back up, write, and verify" Click="Write_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
