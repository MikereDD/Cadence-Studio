<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cadence Universal v1.3 — typography-aware overrides, loaded AFTER
         CadenceUniversal.xaml. No brush definitions here: v1.2 owns palette updates.
         All text sizes bind to TypographyManager's existing scale resources. -->

    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppCaptionFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="TechnicalTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppTechnicalFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppCaptionFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Maintain the existing geometry while making small actions scale with
         Standard/Large/Extra Large instead of fixed 10.5/11.5 pixel values. -->
    <Style x:Key="UtilityPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="FontSize" Value="{DynamicResource AppControlFontSize}" />
    </Style>
    <Style x:Key="StatusPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="FontSize" Value="{DynamicResource AppSmallFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- The library folder row now uses the active typography scale, and
         keyboard navigation shows an accent border without a noisy glow. -->
    <Style x:Key="DarkTreeViewItemStyle" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppControlFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="4,5" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource PremiumSelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DarkTreeViewStyle" TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DarkTreeViewItemStyle}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Padding" Value="0,0,4,4" />
    </Style>
</ResourceDictionary>
