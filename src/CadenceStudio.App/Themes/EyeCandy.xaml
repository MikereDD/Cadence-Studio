                            <Setter TargetName="ModeShadow" Property="Effect"><Setter.Value><DropShadowEffect Color="#625BFF" BlurRadius="14" ShadowDepth="2" Opacity="0.32" /></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ModeMotion" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value></Setter>
                            <Setter TargetName="ModeShell" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ModeShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModeMotion" Property="Opacity" Value="0.34" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
