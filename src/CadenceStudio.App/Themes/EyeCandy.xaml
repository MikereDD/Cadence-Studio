        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppSmallFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="ModeMotion" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="ModeShadow" Margin="1" CornerRadius="13" Background="#01000000"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="11" ShadowDepth="4" Opacity="0.62" /></Border.Effect></Border>
                        <Border x:Name="ModeShell" CornerRadius="13" BorderBrush="#596573" BorderThickness="1.15" Padding="{TemplateBinding Padding}">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#293039" Offset="0" /><GradientStop Color="#15191E" Offset="0.48" /><GradientStop Color="#090B0E" Offset="1" /></LinearGradientBrush></Border.Background>
                            <Grid><Border Height="1" VerticalAlignment="Top" Margin="4,4,4,0" Background="#5FFFFFFF" CornerRadius="2" /><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeShell" Property="BorderBrush" Value="#A6B0BC" /><Setter TargetName="ModeShadow" Property="Effect"><Setter.Value><DropShadowEffect Color="#625BFF" BlurRadius="14" ShadowDepth="2" Opacity="0.32" /></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ModeShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="ModeShell" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ModeMotion" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value></Setter><Setter TargetName="ModeShell" Property="Opacity" Value="0.78" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ModeShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
