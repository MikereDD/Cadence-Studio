<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cadence Studio Eye Candy pass. These resources intentionally override
         the baseline controls while preserving every existing binding and command. -->

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#5B6674" />
        <Setter Property="BorderThickness" Value="1.1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="{DynamicResource AppControlFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="MotionShell" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="ShadowShell" Margin="1" CornerRadius="12" Background="#01000000">
                            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="3" Opacity="0.58" /></Border.Effect>
                        </Border>
                        <Border x:Name="OuterShell" CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2B323A" Offset="0" />
                                    <GradientStop Color="#171B20" Offset="0.52" />
                                    <GradientStop Color="#090B0E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="2">
                                <Border x:Name="InnerShell" CornerRadius="10" BorderBrush="#3AFFFFFF" BorderThickness="0.8">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.34,0.22" GradientOrigin="0.30,0.16" RadiusX="0.95" RadiusY="0.95">
                                            <GradientStop Color="#303844" Offset="0" />
                                            <GradientStop Color="#181D24" Offset="0.55" />
                                            <GradientStop Color="#0A0D11" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border Height="1" VerticalAlignment="Top" Margin="8,4,8,0" Background="#74FFFFFF" CornerRadius="2" Opacity="0.55" />
                                <Border Height="1" VerticalAlignment="Bottom" Margin="8,0,8,4" Background="#35000000" CornerRadius="2" Opacity="0.75" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusRing" Margin="-2" CornerRadius="13" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterShell" Property="BorderBrush" Value="#A6B0BC" />
                            <Setter TargetName="ShadowShell" Property="Effect">
                                <Setter.Value><DropShadowEffect Color="#625BFF" BlurRadius="13" ShadowDepth="2" Opacity="0.28" /></Setter.Value>
                            </Setter>
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.42" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.ReduceMotion, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.018" ScaleY="1.018" /></Setter.Value></Setter>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.968" ScaleY="0.968" /></Setter.Value></Setter>
                            <Setter TargetName="InnerShell" Property="Opacity" Value="0.78" />
                            <Setter TargetName="ShadowShell" Property="Opacity" Value="0.44" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="OuterShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MotionShell" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AccentPillButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#B9B3FF" />
        <Setter Property="BorderThickness" Value="1.2" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="{DynamicResource AppControlFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="MotionShell" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="ShadowShell" Margin="1" CornerRadius="12" Background="#01000000">
                            <Border.Effect><DropShadowEffect Color="#625BFF" BlurRadius="14" ShadowDepth="2" Opacity="0.34" /></Border.Effect>
                        </Border>
                        <Border x:Name="OuterShell" CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#3A3F6F" Offset="0" />
                                    <GradientStop Color="#252A4E" Offset="0.48" />
                                    <GradientStop Color="#111527" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="2">
                                <Border x:Name="InnerShell" CornerRadius="10" BorderBrush="#60FFFFFF" BorderThickness="0.8">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.36,0.20" GradientOrigin="0.31,0.14" RadiusX="0.95" RadiusY="0.95">
                                            <GradientStop Color="#8A87F4" Offset="0" />
                                            <GradientStop Color="#5C5BAE" Offset="0.44" />
                                            <GradientStop Color="#2E345F" Offset="0.76" />
                                            <GradientStop Color="#171B30" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border Height="1" VerticalAlignment="Top" Margin="8,4,8,0" Background="#98FFFFFF" CornerRadius="2" Opacity="0.72" />
                                <Border Height="1" VerticalAlignment="Bottom" Margin="8,0,8,4" Background="#3A000000" CornerRadius="2" Opacity="0.78" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusRing" Margin="-2" CornerRadius="13" BorderBrush="#D1CDFF" BorderThickness="1.2" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterShell" Property="BorderBrush" Value="#D8D4FF" />
                            <Setter TargetName="ShadowShell" Property="Effect">
                                <Setter.Value><DropShadowEffect Color="#726DFF" BlurRadius="16" ShadowDepth="2" Opacity="0.44" /></Setter.Value>
                            </Setter>
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.58" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.ReduceMotion, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.02" ScaleY="1.02" /></Setter.Value></Setter>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.968" ScaleY="0.968" /></Setter.Value></Setter>
                            <Setter TargetName="InnerShell" Property="Opacity" Value="0.82" />
                            <Setter TargetName="ShadowShell" Property="Opacity" Value="0.40" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MotionShell" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="15,11" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="{DynamicResource AppNavigationFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="NavMotion" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="NavShell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="ActiveRail" Width="3" HorizontalAlignment="Left" Margin="-9,2,0,2"
                                        Background="{DynamicResource AccentBrush}" CornerRadius="2" Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="NavShell" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="NavShell" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter TargetName="ActiveRail" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="NavShell" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            <Setter TargetName="NavShell" Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavMotion" Property="Opacity" Value="0.78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TransportButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#697482" />
        <Setter Property="BorderThickness" Value="1.25" />
        <Setter Property="FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="MotionShell" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="OuterShadow" Margin="2" CornerRadius="999" Background="#01000000">
                            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.72" /></Border.Effect>
                        </Border>
                        <Border x:Name="OuterRing" CornerRadius="999" BorderBrush="#6A7684" BorderThickness="1.25">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2B3138" Offset="0" />
                                    <GradientStop Color="#161A1F" Offset="0.5" />
                                    <GradientStop Color="#090B0E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="4">
                                <Border x:Name="InnerFace" CornerRadius="999" BorderBrush="#45101010" BorderThickness="1">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.38,0.28" GradientOrigin="0.32,0.22" RadiusX="0.82" RadiusY="0.82">
                                            <GradientStop Color="#303740" Offset="0" />
                                            <GradientStop Color="#15191E" Offset="0.54" />
                                            <GradientStop Color="#07090C" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border Height="1.2" VerticalAlignment="Top" Margin="10,5,10,0" Background="#78FFFFFF" CornerRadius="2" Opacity="0.52" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusRing" Margin="-3" CornerRadius="999" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterRing" Property="BorderBrush" Value="#A8B3C0" />
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.5" />
                            <Setter TargetName="OuterShadow" Property="Effect">
                                <Setter.Value><DropShadowEffect Color="#736DFF" BlurRadius="15" ShadowDepth="1" Opacity="0.38" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.ReduceMotion, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.045" ScaleY="1.045" /></Setter.Value></Setter>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.93" ScaleY="0.93" /></Setter.Value></Setter>
                            <Setter TargetName="InnerFace" Property="Opacity" Value="0.74" />
                            <Setter TargetName="OuterShadow" Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="0.85" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MotionShell" Property="Opacity" Value="0.34" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="72" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="#B7B3FF" />
        <Setter Property="BorderThickness" Value="1.6" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#625BFF" BlurRadius="18" ShadowDepth="2" Opacity="0.54" /></Setter.Value></Setter>
    </Style>

    <Style x:Key="TransportModeButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="112" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppSmallFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="ModeMotion" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="ModeShadow" Margin="1" CornerRadius="13" Background="#01000000">
                            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="11" ShadowDepth="4" Opacity="0.62" /></Border.Effect>
                        </Border>
                        <Border x:Name="ModeShell" CornerRadius="13" BorderBrush="#596573" BorderThickness="1.15" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#293039" Offset="0" />
                                    <GradientStop Color="#15191E" Offset="0.48" />
                                    <GradientStop Color="#090B0E" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Height="1" VerticalAlignment="Top" Margin="4,4,4,0" Background="#5FFFFFFF" CornerRadius="2" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
