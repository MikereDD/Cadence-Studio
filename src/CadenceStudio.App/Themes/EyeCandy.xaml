    <!-- v1.0-dev.10.7.2: premium progress, queue, lyrics, and loading states. -->
    <Style x:Key="PlayerSliderStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource ControlFillBrush}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="SliderShell" VerticalAlignment="Center" Background="Transparent">
                        <Border Height="6" Background="{DynamicResource BorderSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" />
                        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Background="{TemplateBinding Foreground}" BorderThickness="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" Background="{TemplateBinding Background}" CornerRadius="3">
                                                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1" Opacity="0.35" /></Border.Effect>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid x:Name="ThumbMotion" RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                                                <Ellipse x:Name="ThumbHalo" Fill="{DynamicResource AccentSoftBrush}" Margin="-4" Opacity="0" />
                                                <Ellipse Fill="{DynamicResource ControlThumbBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2">
                                                    <Ellipse.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.62" /></Ellipse.Effect>
                                                </Ellipse>
                                                <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbHalo" Property="Opacity" Value="0.72" />
                                                    <Setter TargetName="ThumbMotion" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.12" ScaleY="1.12" /></Setter.Value></Setter>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbHalo" Property="Opacity" Value="1" />
                                                    <Setter TargetName="ThumbMotion" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.2" ScaleY="1.2" /></Setter.Value></Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Background="Transparent" BorderThickness="0">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="8" Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SliderShell" Property="Opacity" Value="1" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SliderShell" Property="Opacity" Value="0.36" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ExpandedQueueCardItemStyle" TargetType="ListBoxItem">
