                        <Border x:Name="ModeShell" CornerRadius="11" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#293039" Offset="0" /><GradientStop Color="#15191E" Offset="0.48" /><GradientStop Color="#090B0E" Offset="1" /></LinearGradientBrush></Border.Background>
                            <Grid>
                                <Border Height="1" VerticalAlignment="Top" Margin="4,4,4,0" Background="#5FFFFFFF" CornerRadius="2" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeShell" Property="BorderBrush" Value="#A6B0BC" /><Setter TargetName="ModeShadow" Property="Effect"><Setter.Value><DropShadowEffect Color="#625BFF" BlurRadius="13" ShadowDepth="2" Opacity="0.24" /></Setter.Value></Setter><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="ModeShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="ModeShadow" Property="Effect"><Setter.Value><DropShadowEffect Color="#625BFF" BlurRadius="13" ShadowDepth="2" Opacity="0.26" /></Setter.Value></Setter><Setter TargetName="ModeShell" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ModeMotion" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter><Setter TargetName="ModeShell" Property="Opacity" Value="0.80" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModeMotion" Property="Opacity" Value="0.38" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="ItemShell" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="SelectionRail" Width="3" HorizontalAlignment="Left" Margin="2,7,0,7"
                                Background="{DynamicResource ControlActiveBrush}" CornerRadius="2" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                            <Setter TargetName="ItemShell" Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            <Setter TargetName="ItemShell" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter TargetName="SelectionRail" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

