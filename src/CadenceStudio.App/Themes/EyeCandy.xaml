        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="MotionShell" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="QueueCard" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="16" Padding="13"><Border.Effect><DropShadowEffect Color="#66000000" BlurRadius="16" ShadowDepth="5" Opacity="0.58" /></Border.Effect>
                            <Grid>
                                <Border x:Name="AccentRail" Width="3" HorizontalAlignment="Left" Margin="-8,10,0,10" Background="{DynamicResource AccentBrush}" CornerRadius="2" Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                <Ellipse x:Name="SelectionDot" Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}" Opacity="0" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="QueueCard" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                            <Setter TargetName="QueueCard" Property="BorderBrush" Value="{DynamicResource ControlActiveBrush}" />
                            <Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.018" ScaleY="1.018" /></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="QueueCard" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter TargetName="QueueCard" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="QueueCard" Property="BorderThickness" Value="1.5" />
                            <Setter TargetName="AccentRail" Property="Opacity" Value="1" />
                            <Setter TargetName="SelectionDot" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

