    <Style x:Key="InfoTabToggleStyle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="#596573" />
        <Setter Property="BorderThickness" Value="1.05" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="FontSize" Value="{DynamicResource AppSmallFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="TabMotion" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="TabShadow" Margin="1" CornerRadius="10" Background="#01000000"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="9" ShadowDepth="3" Opacity="0.50" /></Border.Effect></Border>
                        <Border x:Name="TabShell" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#293039" Offset="0" /><GradientStop Color="#15191E" Offset="0.48" /><GradientStop Color="#090B0E" Offset="1" /></LinearGradientBrush></Border.Background>
                            <Grid>
                                <Border Height="1" VerticalAlignment="Top" Margin="4,4,4,0" Background="#5FFFFFFF" CornerRadius="2" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabShell" Property="BorderBrush" Value="#A6B0BC" /><Setter TargetName="TabShadow" Property="Effect"><Setter.Value><DropShadowEffect Color="#625BFF" BlurRadius="12" ShadowDepth="2" Opacity="0.22" /></Setter.Value></Setter><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="TabShell" Property="BorderBrush" Value="{DynamicResource ControlActiveBrush}" /><Setter TargetName="TabShadow" Property="Effect"><Setter.Value><DropShadowEffect Color="#625BFF" BlurRadius="12" ShadowDepth="2" Opacity="0.26" /></Setter.Value></Setter><Setter TargetName="TabShell" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabMotion" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter><Setter TargetName="TabShell" Property="Opacity" Value="0.80" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabMotion" Property="Opacity" Value="0.38" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

