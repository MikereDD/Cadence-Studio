<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowColor">#090B0F</Color>
    <Color x:Key="SidebarColor">#0D1015</Color>
    <Color x:Key="SurfaceColor">#11151B</Color>
    <Color x:Key="SurfaceRaisedColor">#171C24</Color>
    <Color x:Key="SurfaceHoverColor">#202630</Color>
    <Color x:Key="BorderColor">#2A313C</Color>
    <Color x:Key="BorderSoftColor">#1D232C</Color>
    <Color x:Key="TextPrimaryColor">#F2F4F7</Color>
    <Color x:Key="TextSecondaryColor">#A8B0BD</Color>
    <Color x:Key="TextMutedColor">#737D8C</Color>
    <Color x:Key="AccentColor">#777BC7</Color>
    <Color x:Key="AccentTextColor">#FFFFFF</Color>
    <Color x:Key="DangerColor">#D56B73</Color>
    <Color x:Key="SuccessColor">#7BC99B</Color>
    <Color x:Key="ControlFillColor">#7D8694</Color>
    <Color x:Key="ControlThumbColor">#C7CDD6</Color>
    <Color x:Key="ControlActiveColor">#929BA8</Color>
    <Color x:Key="AccentSoftColor">#31354B</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}" />
    <SolidColorBrush x:Key="ControlThumbBrush" Color="{StaticResource ControlThumbColor}" />
    <SolidColorBrush x:Key="ControlActiveBrush" Color="{StaticResource ControlActiveColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />


    <Color x:Key="VisualizerBand0Color">#B6BDC7</Color>
    <Color x:Key="VisualizerBand1Color">#CCD2D9</Color>
    <Color x:Key="VisualizerBand2Color">#AEB7C2</Color>
    <Color x:Key="VisualizerBand3Color">#8F9AAA</Color>
    <Color x:Key="VisualizerBand4Color">#C3CBD5</Color>
    <Color x:Key="VisualizerBand5Color">#E3E7EC</Color>
    <Color x:Key="VisualizerBand6Color">#FFFFFF</Color>
    <Color x:Key="VisualizerCoreColor">#F4F7FA</Color>
    <Color x:Key="VisualizerAtmosphereColor">#6C7580</Color>

    <SolidColorBrush x:Key="VisualizerBand0Brush" Color="{StaticResource VisualizerBand0Color}" />
    <SolidColorBrush x:Key="VisualizerBand1Brush" Color="{StaticResource VisualizerBand1Color}" />
    <SolidColorBrush x:Key="VisualizerBand2Brush" Color="{StaticResource VisualizerBand2Color}" />
    <SolidColorBrush x:Key="VisualizerBand3Brush" Color="{StaticResource VisualizerBand3Color}" />
    <SolidColorBrush x:Key="VisualizerBand4Brush" Color="{StaticResource VisualizerBand4Color}" />
    <SolidColorBrush x:Key="VisualizerBand5Brush" Color="{StaticResource VisualizerBand5Color}" />
    <SolidColorBrush x:Key="VisualizerBand6Brush" Color="{StaticResource VisualizerBand6Color}" />
    <SolidColorBrush x:Key="VisualizerCoreBrush" Color="{StaticResource VisualizerCoreColor}" />
    <SolidColorBrush x:Key="VisualizerAtmosphereBrush" Color="{StaticResource VisualizerAtmosphereColor}" />

    <!-- Keep WPF fallback chrome dark, including the ScrollViewer corner where
         horizontal and vertical scrollbars meet. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="{StaticResource WindowColor}" />

    <LinearGradientBrush x:Key="WindowDepthBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#10141A" Offset="0" />
        <GradientStop Color="#090B0F" Offset="0.55" />
        <GradientStop Color="#07090C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AlbumArtPlaceholderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#252B35" Offset="0" />
        <GradientStop Color="#12161C" Offset="0.5" />
        <GradientStop Color="#080A0E" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
