<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- v1.0-dev.10.9 premium visual-language foundation. Loaded after the
         baseline and Eye Candy dictionaries so existing bindings and commands
         inherit the richer surfaces without being rewritten. -->

    <LinearGradientBrush x:Key="PremiumCardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource SurfaceRaisedColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SurfaceColor}" Offset="0.55" />
        <GradientStop Color="{DynamicResource WindowColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PremiumCardHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource SurfaceHoverColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SurfaceRaisedColor}" Offset="0.58" />
        <GradientStop Color="{DynamicResource SurfaceColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PremiumButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource SurfaceHoverColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SurfaceRaisedColor}" Offset="0.48" />
        <GradientStop Color="{DynamicResource SurfaceColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PremiumButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource ControlActiveColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SurfaceHoverColor}" Offset="0.32" />
        <GradientStop Color="{DynamicResource SurfaceRaisedColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PremiumButtonPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{DynamicResource SurfaceColor}" Offset="0" />
        <GradientStop Color="{DynamicResource WindowColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PremiumAccentButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
        <GradientStop Color="{DynamicResource AccentSoftColor}" Offset="0.7" />
        <GradientStop Color="{DynamicResource SurfaceRaisedColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PremiumAccentButtonHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource ControlActiveColor}" Offset="0" />
        <GradientStop Color="{DynamicResource AccentColor}" Offset="0.28" />
        <GradientStop Color="{DynamicResource AccentSoftColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PremiumMenuBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource SurfaceRaisedColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SurfaceColor}" Offset="0.72" />
        <GradientStop Color="{DynamicResource WindowColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PremiumSelectionBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{DynamicResource AccentSoftColor}" Offset="0" />
        <GradientStop Color="{DynamicResource SurfaceHoverColor}" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="PremiumHeroPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PremiumCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.46" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PremiumCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.42" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontSize" Value="{DynamicResource AppControlFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="MotionShell" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="Shadow" Margin="1,2,1,0" CornerRadius="10" Background="#01000000">
                            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="9" ShadowDepth="2" Opacity="0.32" /></Border.Effect>
                        </Border>
                        <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <Grid>
                                <Border x:Name="InnerHighlight" Margin="1" CornerRadius="9" BorderBrush="#20FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
                                <Border Height="1" Margin="11,3,11,0" VerticalAlignment="Top" Background="#70FFFFFF" Opacity="0.38" CornerRadius="1" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0" RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusHalo" Margin="-2" CornerRadius="12" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.25" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="{DynamicResource PremiumButtonHoverBrush}" />
                            <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource ControlThumbBrush}" />
                            <Setter TargetName="InnerHighlight" Property="BorderBrush" Value="#34FFFFFF" />
                            <Setter TargetName="FocusHalo" Property="Opacity" Value="0.26" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.ReduceMotion, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.012" ScaleY="1.012" /></Setter.Value></Setter>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="{DynamicResource PremiumButtonPressedBrush}" />
                            <Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" /></Setter.Value></Setter>
                            <Setter TargetName="Shadow" Property="Opacity" Value="0.2" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="FocusHalo" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MotionShell" Property="Opacity" Value="0.38" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource PremiumAccentButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="MotionShell" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="Shadow" Margin="1,2,1,0" CornerRadius="11" Background="#01000000">
                            <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="12" ShadowDepth="2" Opacity="0.30" /></Border.Effect>
                        </Border>
                        <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                            <Grid>
                                <Border x:Name="InnerHighlight" Margin="1" CornerRadius="10" BorderBrush="#38FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
                                <Border Height="1" Margin="12,3,12,0" VerticalAlignment="Top" Background="#A0FFFFFF" Opacity="0.48" CornerRadius="1" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0" RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusHalo" Margin="-2" CornerRadius="13" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="{DynamicResource PremiumAccentButtonHoverBrush}" />
                            <Setter TargetName="Outer" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                            <Setter TargetName="InnerHighlight" Property="BorderBrush" Value="#55FFFFFF" />
                            <Setter TargetName="FocusHalo" Property="Opacity" Value="0.42" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.ReduceMotion, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.015" ScaleY="1.015" /></Setter.Value></Setter>
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outer" Property="Background" Value="{DynamicResource PremiumAccentButtonPressedBrush}" />
                            <Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.978" ScaleY="0.978" /></Setter.Value></Setter>
                            <Setter TargetName="Shadow" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusHalo" Property="Opacity" Value="0.85" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MotionShell" Property="Opacity" Value="0.38" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipToggleStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppControlFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="MotionShell" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <Grid>
                                <Border Margin="2" CornerRadius="8" BorderBrush="#30FFFFFF" BorderThickness="1" />
                                <Ellipse x:Name="ActiveLight" Width="5" Height="5" HorizontalAlignment="Left" Margin="8,0,0,0" Fill="{DynamicResource AccentBrush}" Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource PremiumButtonHoverBrush}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource ControlThumbBrush}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource PremiumSelectionBrush}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="2" />
                            <Setter TargetName="ActiveLight" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MotionShell" Property="Opacity" Value="0.36" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InfoTabToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ChipToggleStyle}">
        <Setter Property="MinWidth" Value="78" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="UtilityPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Padding" Value="13,6" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style x:Key="PrimaryPillButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentPillButtonStyle}">
        <Setter Property="MinHeight" Value="35" />
        <Setter Property="Padding" Value="17,7" />
    </Style>

    <Style x:Key="StatusPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style x:Key="ThemeCardToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="228" />
        <Setter Property="MinHeight" Value="116" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PremiumCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="MotionShell" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="Shadow" Margin="2" CornerRadius="17" Background="#01000000"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="5" Opacity="0.42"/></Border.Effect></Border>
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border Margin="-13,-13,-13,-13" CornerRadius="15" BorderBrush="#24FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
                                <Border x:Name="AccentRail" Width="4" HorizontalAlignment="Left" Margin="-10,6,0,6" Background="{DynamicResource AccentBrush}" CornerRadius="2" Opacity="0" />
                                <ContentPresenter />
                                <Ellipse x:Name="SelectedLight" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}" Opacity="0">
                                    <Ellipse.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource PremiumCardHoverBrush}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource ControlThumbBrush}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.ReduceMotion, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.018" ScaleY="1.018"/></Setter.Value></Setter>
                        </MultiDataTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="1.5" />
                            <Setter TargetName="AccentRail" Property="Opacity" Value="1" />
                            <Setter TargetName="SelectedLight" Property="Opacity" Value="1" />
                            <Setter TargetName="Shadow" Property="Effect"><Setter.Value><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="19" ShadowDepth="4" Opacity="0.38"/></Setter.Value></Setter>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MotionShell" Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TypographyCardToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ThemeCardToggleStyle}" />
    <Style x:Key="TextScaleToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ThemeCardToggleStyle}">
        <Setter Property="Width" Value="176" />
        <Setter Property="MinHeight" Value="100" />
    </Style>

    <Style x:Key="PremiumComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="3,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemShell" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                        <Grid>
                            <Border x:Name="AccentRail" Width="3" HorizontalAlignment="Left" Margin="-7,2,0,2" Background="{DynamicResource AccentBrush}" CornerRadius="2" Opacity="0" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource PremiumButtonHoverBrush}"/><Setter TargetName="ItemShell" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemShell" Property="Background" Value="{DynamicResource PremiumSelectionBrush}"/><Setter TargetName="ItemShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="AccentRail" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PremiumComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppControlFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PremiumComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Shadow" Margin="1" CornerRadius="14" Background="#01000000"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.44"/></Border.Effect></Border>
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                                <Border Margin="2" Grid.ColumnSpan="2" CornerRadius="12" BorderBrush="#32FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" TextElement.Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" />
                                <Border Grid.Column="1" Margin="0,4,4,4" CornerRadius="10" Background="{DynamicResource PremiumCardBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                    <Grid>
                                        <Ellipse Width="22" Height="22" Fill="{DynamicResource AccentSoftBrush}" Opacity="0.58" />
                                        <TextBlock x:Name="Arrow" Text="⌄" FontFamily="Segoe UI Symbol" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="440" Margin="0,7,0,0"
                                    Background="{DynamicResource PremiumMenuBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="4">
                                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="8" Opacity="0.78"/></Border.Effect>
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource PremiumButtonHoverBrush}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource ControlThumbBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Arrow" Property="Text" Value="⌃"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBoxStyle}" />
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource PremiumComboBoxItemStyle}" />

    <!-- Theme-aware premium popup system shared by visualizer launchers, context menus, and future command menus. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="8">
                        <Border CornerRadius="14" Background="#02000000">
                            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.74"/></Border.Effect>
                        </Border>
                        <Border x:Name="Chrome" Background="{DynamicResource PremiumMenuBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.25" CornerRadius="14" Padding="7">
                            <Grid>
                                <Border Margin="1" CornerRadius="12" BorderBrush="#26FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,10" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <Grid MinWidth="165">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border x:Name="AccentRail" Grid.Column="0" Width="3" Margin="0,1,10,1" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="2" Opacity="0"/>
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                            <Path x:Name="SubmenuArrow" Grid.Column="2" Data="M 0 0 L 4 4 L 0 8" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.4" Margin="12,0,2,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource PremiumSelectionBrush}"/>
                            <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="AccentRail" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource PremiumButtonPressedBrush}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Margin" Value="10,6"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter>
    </Style>


    <Style x:Key="SearchBoxStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.32"/></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PremiumButtonHoverBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlThumbBrush}"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="{DynamicResource PremiumCardHoverBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="15,11" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FontSize" Value="{DynamicResource AppNavigationFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="MotionShell" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="ActiveRail" Width="4" HorizontalAlignment="Left" Margin="-10,2,0,2" Background="{DynamicResource AccentBrush}" CornerRadius="2" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                                <Ellipse x:Name="ActiveLight" Width="7" Height="7" HorizontalAlignment="Right" Fill="{DynamicResource AccentBrush}" Opacity="0"><Ellipse.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="9" ShadowDepth="0" Opacity="0.85"/></Ellipse.Effect></Ellipse>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource PremiumButtonHoverBrush}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Shell" Property="Background" Value="{DynamicResource PremiumSelectionBrush}"/><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="ActiveRail" Property="Opacity" Value="1"/><Setter TargetName="ActiveLight" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TransportButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="50" />
        <Setter Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.25" />
        <Setter Property="FontFamily" Value="Segoe UI Symbol" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="MotionShell" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Ellipse x:Name="Shadow" Margin="2" Fill="#01000000"><Ellipse.Effect><DropShadowEffect Color="#000000" BlurRadius="15" ShadowDepth="5" Opacity="0.68"/></Ellipse.Effect></Ellipse>
                        <Ellipse x:Name="Outer" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}"/>
                        <Ellipse Margin="4" Stroke="#38FFFFFF" StrokeThickness="1"/>
                        <Ellipse Margin="7" Opacity="0.20"><Ellipse.Fill><RadialGradientBrush Center="0.35,0.25" GradientOrigin="0.32,0.20" RadiusX="0.8" RadiusY="0.8"><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" TextElement.FontFamily="Segoe UI Symbol" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="SemiBold" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <Ellipse x:Name="FocusHalo" Margin="-3" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="Fill" Value="{DynamicResource PremiumButtonHoverBrush}"/><Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource ControlThumbBrush}"/><Setter TargetName="FocusHalo" Property="Opacity" Value="0.6"/><Setter TargetName="Shadow" Property="Effect"><Setter.Value><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="18" ShadowDepth="2" Opacity="0.42"/></Setter.Value></Setter></Trigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding DataContext.ReduceMotion, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.05" ScaleY="1.05"/></Setter.Value></Setter></MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Outer" Property="Fill" Value="{DynamicResource PremiumButtonPressedBrush}"/><Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92"/></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusHalo" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MotionShell" Property="Opacity" Value="0.34"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}">
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="72" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource PremiumAccentButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="MotionShell" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Ellipse x:Name="Shadow" Margin="1" Fill="#01000000"><Ellipse.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="22" ShadowDepth="4" Opacity="0.58"/></Ellipse.Effect></Ellipse>
                        <Ellipse x:Name="Outer" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5"/>
                        <Ellipse Margin="4" Stroke="#58FFFFFF" StrokeThickness="1"/>
                        <Ellipse Margin="7" Opacity="0.24"><Ellipse.Fill><RadialGradientBrush Center="0.34,0.22" GradientOrigin="0.30,0.18" RadiusX="0.82" RadiusY="0.82"><GradientStop Color="#FFFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
                        <Grid Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="PlayIcon" Data="M 4,2 L 4,30 L 29,16 Z" Fill="{TemplateBinding Foreground}" Stretch="Uniform" Margin="2,1,0,1"/>
                            <Grid x:Name="PauseIcon" Visibility="Collapsed" Width="28" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="8"/><ColumnDefinition Width="10"/></Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" RadiusX="2" RadiusY="2" Fill="{TemplateBinding Foreground}"/>
                                <Rectangle Grid.Column="2" RadiusX="2" RadiusY="2" Fill="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Grid>
                        <Ellipse x:Name="FocusHalo" Margin="-4" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsPlaybackPlaying}" Value="True"><Setter TargetName="PlayIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="PauseIcon" Property="Visibility" Value="Visible"/></DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="Fill" Value="{DynamicResource PremiumAccentButtonHoverBrush}"/><Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource AccentTextBrush}"/><Setter TargetName="FocusHalo" Property="Opacity" Value="0.78"/></Trigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/><Condition Binding="{Binding DataContext.ReduceMotion, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.055" ScaleY="1.055"/></Setter.Value></Setter></MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="MotionShell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.91" ScaleY="0.91"/></Setter.Value></Setter><Setter TargetName="Shadow" Property="Opacity" Value="0.46"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusHalo" Property="Opacity" Value="1"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MotionShell" Property="Opacity" Value="0.34"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HeroTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButtonStyle}"><Setter Property="Width" Value="54"/><Setter Property="Height" Value="54"/><Setter Property="FontSize" Value="19"/></Style>
