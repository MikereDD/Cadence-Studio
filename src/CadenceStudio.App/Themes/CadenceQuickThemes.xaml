<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Universal v1.5: small theme-aware launcher on the Library header.
         Menu selection is delegated to the EXISTING ApplyThemeCommand. -->
    <Style x:Key="QuickThemeButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="7" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
        <Setter Property="ToolTipService.ShowDuration" Value="12000" />
    </Style>

    <!-- Same popup chrome and rows as Window Visualizer and pop-out preset menu. -->
    <Style x:Key="QuickThemeContextMenuStyle" TargetType="ContextMenu"
           BasedOn="{StaticResource CadenceUnifiedContextMenuStyle}">
        <Setter Property="Tag" Value="QUICK THEMES"/>
    </Style>
    <Style x:Key="QuickThemeChoiceStyle" TargetType="MenuItem"
           BasedOn="{StaticResource CadenceUnifiedMenuItemStyle}"/>
</ResourceDictionary>
