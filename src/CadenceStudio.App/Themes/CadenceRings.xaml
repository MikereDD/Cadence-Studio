<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Universal v1.4: outline-only accent language. Designed to load after v1.3.
         All accents use the live six-theme AccentBrush; no hard-coded palette colors.
         Top half accent ring = upper horizontal edge and upper half of both sides. -->

    <!-- Shared action-button template: off = neutral outline, hover = half ring,
         pressed / focused = full ring. Actions never remain selected. -->
    <ControlTemplate x:Key="UniversalRingButtonTemplate" TargetType="Button">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Shell" CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <Grid IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="UpperRing" Grid.Row="0" CornerRadius="10,10,0,0"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2,2,2,0" Visibility="Collapsed" />
            </Grid>
            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                <ContentPresenter RecognizesAccessKey="True"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <Border x:Name="FullRing" CornerRadius="10" BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource PremiumButtonHoverBrush}" />
                <Setter TargetName="UpperRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource PremiumButtonPressedBrush}" />
                <Setter TargetName="FullRing" Property="Visibility" Value="Visible" />
                <Setter TargetName="UpperRing" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FullRing" Property="Visibility" Value="Visible" />
                <Setter TargetName="UpperRing" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Shell" Property="Opacity" Value="0.60" />
                <Setter TargetName="UpperRing" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="FullRing" Property="Visibility" Value="Collapsed" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Native WPF three-state ring: off = no accent, null/indeterminate = half,
         checked = full. Existing binary toggles retain their two-state behavior. -->
    <ControlTemplate x:Key="UniversalRingToggleTemplate" TargetType="ToggleButton">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Shell" CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <Grid IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="UpperRing" Grid.Row="0" CornerRadius="10,10,0,0"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="2,2,2,0" Visibility="Collapsed" />
            </Grid>
            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                <ContentPresenter RecognizesAccessKey="True"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <Border x:Name="FullRing" CornerRadius="10" BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource PremiumButtonHoverBrush}" />
                <Setter TargetName="UpperRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="UpperRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="FullRing" Property="Visibility" Value="Visible" />
                <Setter TargetName="UpperRing" Property="Visibility" Value="Collapsed" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FullRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Shell" Property="Opacity" Value="0.60" />
                <Setter TargetName="UpperRing" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="FullRing" Property="Visibility" Value="Collapsed" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Replace accent-fill buttons at their common source, without changing any
         command, binding, hit target, layout placement, or audio logic. -->
    <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppControlFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="13,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource UniversalRingButtonTemplate}" />
    </Style>
    <Style x:Key="AccentPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}" />
    <Style x:Key="PrimaryPillButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentPillButtonStyle}">
        <Setter Property="MinHeight" Value="35" />
        <Setter Property="Padding" Value="17,7" />
    </Style>
    <Style x:Key="UtilityPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}" />
    <Style x:Key="StatusPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="FontSize" Value="{DynamicResource AppSmallFontSize}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="TreeActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <Style x:Key="FocusModeButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style x:Key="TransportModeButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="112" />
        <Setter Property="Padding" Value="15,0" />
    </Style>

    <Style x:Key="ChipToggleStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource AppSmallFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource UniversalRingToggleTemplate}" />
    </Style>
    <Style x:Key="TransportModeToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ChipToggleStyle}">
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="112" />
        <Setter Property="Padding" Value="15,0" />
    </Style>
    <Style x:Key="NavToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ChipToggleStyle}">
        <Setter Property="FontSize" Value="{DynamicResource AppNavigationFontSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="15,11" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style x:Key="InfoTabToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ChipToggleStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style x:Key="ThemeCardToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ChipToggleStyle}">
        <Setter Property="Width" Value="228" />
        <Setter Property="MinHeight" Value="116" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{DynamicResource PremiumCardBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="TypographyCardToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ThemeCardToggleStyle}" />
    <Style x:Key="TextScaleToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ThemeCardToggleStyle}">
        <Setter Property="Width" Value="176" />
        <Setter Property="MinHeight" Value="100" />
    </Style>
    <!-- For a future explicitly configured tri-state control only. No existing
         nav/theme/shuffle/repeat toggle is silently changed to three-state. -->
    <Style x:Key="ThreeStateRingToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ChipToggleStyle}">
        <Setter Property="IsThreeState" Value="True" />
    </Style>
</ResourceDictionary>
