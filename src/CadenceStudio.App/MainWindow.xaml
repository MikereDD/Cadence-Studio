                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Fullscreen" Margin="8,0,0,0" IsChecked="{Binding IsWindowModeFullscreen, Mode=OneWay}" Command="{Binding SetWindowVisualizerModeCommand}" CommandParameter="Fullscreen"/>
                                                </StackPanel>

                                                <TextBlock Text="WINDOW PRESET" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,15,0,0"/>
                                                <WrapPanel Margin="0,9,0,0">
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Celestial Resonance" IsChecked="{Binding IsWindowPresetCelestial, Mode=OneWay}" Command="{Binding SetWindowVisualizerPresetCommand}" CommandParameter="CelestialResonance" Margin="0,0,8,8"/>
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Aurora Cascade" IsChecked="{Binding IsWindowPresetAurora, Mode=OneWay}" Command="{Binding SetWindowVisualizerPresetCommand}" CommandParameter="AuroraCascade" Margin="0,0,8,8"/>
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Glass Horizon" IsChecked="{Binding IsWindowPresetGlass, Mode=OneWay}" Command="{Binding SetWindowVisualizerPresetCommand}" CommandParameter="GlassHorizon" Margin="0,0,8,8"/>
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Infinite Windows" IsChecked="{Binding IsWindowPresetInfinite, Mode=OneWay}" Command="{Binding SetWindowVisualizerPresetCommand}" CommandParameter="InfiniteWindows" Margin="0,0,8,8"/>
                                                </WrapPanel>

                                                <Button Style="{StaticResource PrimaryPillButtonStyle}" Content="Open Window Visualizer" Click="OpenWindowVisualizer_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>

                                                <WrapPanel Margin="0,14,0,0">
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Album colors" IsChecked="{Binding IsAlbumColorIntegrationEnabled, Mode=OneWay}" Command="{Binding ToggleAlbumColorIntegrationCommand}" Margin="0,0,8,8"/>
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Always on top" IsChecked="{Binding IsWindowVisualizerAlwaysOnTop, Mode=OneWay}" Command="{Binding ToggleWindowAlwaysOnTopCommand}" Margin="0,0,8,8"/>
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Remember placement" IsChecked="{Binding IsRememberWindowPlacementEnabled, Mode=OneWay}" Command="{Binding ToggleRememberWindowPlacementCommand}" Margin="0,0,8,8"/>
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Auto-open" IsChecked="{Binding IsAutoOpenWindowVisualizerEnabled, Mode=OneWay}" Command="{Binding ToggleAutoOpenWindowVisualizerCommand}" Margin="0,0,8,8"/>
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Playback controls" IsChecked="{Binding IsWindowPlaybackControlsEnabled, Mode=OneWay}" Command="{Binding ToggleWindowPlaybackControlsCommand}" Margin="0,0,8,8"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,16,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="WINDOW QUALITY" Style="{StaticResource CaptionStyle}" FontWeight="Bold"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Balanced" IsChecked="{Binding IsWindowQualityBalanced, Mode=OneWay}" Command="{Binding SetWindowVisualizerQualityCommand}" CommandParameter="Balanced"/>
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="High" Margin="8,0,0,0" IsChecked="{Binding IsWindowQualityHigh, Mode=OneWay}" Command="{Binding SetWindowVisualizerQualityCommand}" CommandParameter="High"/>
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Ultra" Margin="8,0,0,0" IsChecked="{Binding IsWindowQualityUltra, Mode=OneWay}" Command="{Binding SetWindowVisualizerQualityCommand}" CommandParameter="Ultra"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="FRAME RATE" Style="{StaticResource CaptionStyle}" FontWeight="Bold"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="30" IsChecked="{Binding IsWindowFrameRate30, Mode=OneWay}" Command="{Binding SetWindowVisualizerFrameRateCommand}" CommandParameter="30"/>
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="60" Margin="8,0,0,0" IsChecked="{Binding IsWindowFrameRate60, Mode=OneWay}" Command="{Binding SetWindowVisualizerFrameRateCommand}" CommandParameter="60"/>
                                                    <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="120" Margin="8,0,0,0" IsChecked="{Binding IsWindowFrameRate120, Mode=OneWay}" Command="{Binding SetWindowVisualizerFrameRateCommand}" CommandParameter="120"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <Grid><TextBlock Text="PARTICLES" Style="{StaticResource CaptionStyle}" FontWeight="Bold"/><TextBlock Text="{Binding WindowParticleIntensityText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"/></Grid>
                                                <Slider Minimum="0" Maximum="1" Value="{Binding WindowParticleIntensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PlayerSliderStyle}" Margin="0,10,0,0"/>
                                                <Grid Margin="0,12,0,0"><TextBlock Text="REFLECTIONS" Style="{StaticResource CaptionStyle}" FontWeight="Bold"/><TextBlock Text="{Binding WindowReflectionIntensityText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"/></Grid>
                                                <Slider Minimum="0" Maximum="1" Value="{Binding WindowReflectionIntensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PlayerSliderStyle}" Margin="0,10,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,16,0,18">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="NOW PLAYING NOTIFICATION" Style="{StaticResource PanelTitleStyle}"/>
                                            <TextBlock Text="Theme-aware song-change popup with artwork and playback controls." Style="{StaticResource CaptionStyle}" Margin="0,4,0,12"/>
                                            <WrapPanel>
                                                <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Enabled" IsChecked="{Binding SongChangePopupEnabled, Mode=TwoWay}" Margin="0,0,8,8"/>
                                                <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="Suppress while focused" IsChecked="{Binding SuppressPopupWhileCadenceFocused, Mode=TwoWay}" Margin="0,0,8,8"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <Grid><TextBlock Text="DURATION" Style="{StaticResource CaptionStyle}" FontWeight="Bold"/><TextBlock Text="{Binding SongChangePopupDurationText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"/></Grid>
                                            <Slider Minimum="1.5" Maximum="12" Value="{Binding SongChangePopupDurationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PlayerSliderStyle}" Margin="0,8,0,12"/>
                                            <TextBlock Text="SCREEN CORNER" Style="{StaticResource CaptionStyle}" FontWeight="Bold"/>
                                            <ComboBox SelectedValue="{Binding SongChangePopupCorner, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource PremiumComboBoxStyle}" Margin="0,7,0,0">
                                                <ComboBoxItem Content="Top left" Tag="TopLeft"/><ComboBoxItem Content="Top right" Tag="TopRight"/><ComboBoxItem Content="Bottom left" Tag="BottomLeft"/><ComboBoxItem Content="Bottom right" Tag="BottomRight"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,0,0,22" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Live FFT visualizer" Style="{StaticResource PanelTitleStyle}" />
                                        <TextBlock Text="Render the real playback spectrum with adjustable sensitivity, decay, density, and palette."
                                                   Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ChipToggleStyle}"
                                                  IsChecked="{Binding IsVisualizerEnabled, Mode=OneWay}"
                                                  Command="{Binding ToggleVisualizerCommand}"
                                                  Content="{Binding VisualizerToggleLabel}" />
                                </Grid>

                                <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,18,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="64" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="SENSITIVITY" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding VisualizerSensitivityText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider Minimum="0.5" Maximum="2.0" Value="{Binding VisualizerSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource PlayerSliderStyle}" IsMoveToPointEnabled="True" SmallChange="0.1" LargeChange="0.25" Margin="0,10,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="DECAY" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding VisualizerDecayText}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Slider Minimum="0.55" Maximum="0.96" Value="{Binding VisualizerDecay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource PlayerSliderStyle}" IsMoveToPointEnabled="True" SmallChange="0.02" LargeChange="0.08" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding VisualizerStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="Monochrome remains the default; optional visualizer palettes do not change the Studio theme."
                                                   Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="24" Command="{Binding SetVisualizerDensityCommand}" CommandParameter="24" ToolTip="24 spectrum bars">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVisualizer24Bars}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                            <Setter Property="BorderBrush" Value="#697483" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="32" Command="{Binding SetVisualizerDensityCommand}" CommandParameter="32" Margin="8,0,0,0" ToolTip="32 spectrum bars">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVisualizer32Bars}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                            <Setter Property="BorderBrush" Value="#697483" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="48" Command="{Binding SetVisualizerDensityCommand}" CommandParameter="48" Margin="8,0,0,0" ToolTip="48 spectrum bars">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVisualizer48Bars}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                            <Setter Property="BorderBrush" Value="#697483" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Style="{StaticResource PillButtonStyle}" Content="{Binding VisualizerLabel}" Command="{Binding CycleVisualizerCommand}" Margin="8,0,0,0" ToolTip="Cycle visualizer palette" />
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,22,0,22" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="10-band equalizer" Style="{StaticResource PanelTitleStyle}" />
                                        <TextBlock Text="Shape playback in real time with presets, custom band control, preamp, and clipping protection."
                                                   Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource ChipToggleStyle}"
                                                  IsChecked="{Binding IsEqualizerEnabled, Mode=OneWay}"
                                                  Command="{Binding ToggleEqualizerCommand}"
                                                  Content="{Binding EqualizerToggleLabel}" ToolTip="Bypass or enable the equalizer" />
                                </Grid>

                                <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,18,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding EqualizerPresetName}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding EqualizerStatusText}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource UtilityPillButtonStyle}" Content="Flat"
                                                    Command="{Binding ApplyEqualizerPresetCommand}" CommandParameter="Flat" />
                                            <Button Style="{StaticResource UtilityPillButtonStyle}" Content="Reset" Margin="8,0,0,0"
                                                    Command="{Binding ResetEqualizerCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="PRESETS" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Margin="2,18,0,8" />
                                <WrapPanel>
                                    <Button Style="{StaticResource PillButtonStyle}" Content="Bass Boost" Margin="0,0,8,8"
                                            Command="{Binding ApplyEqualizerPresetCommand}" CommandParameter="Bass Boost" />
                                    <Button Style="{StaticResource PillButtonStyle}" Content="Treble Boost" Margin="0,0,8,8"
                                            Command="{Binding ApplyEqualizerPresetCommand}" CommandParameter="Treble Boost" />
                                    <Button Style="{StaticResource PillButtonStyle}" Content="Vocal" Margin="0,0,8,8"
                                            Command="{Binding ApplyEqualizerPresetCommand}" CommandParameter="Vocal" />
                                    <Button Style="{StaticResource PillButtonStyle}" Content="Rock" Margin="0,0,8,8"
                                            Command="{Binding ApplyEqualizerPresetCommand}" CommandParameter="Rock" />
                                    <Button Style="{StaticResource PillButtonStyle}" Content="Electronic" Margin="0,0,8,8"
                                            Command="{Binding ApplyEqualizerPresetCommand}" CommandParameter="Electronic" />
                                    <Button Style="{StaticResource PillButtonStyle}" Content="Classical" Margin="0,0,8,8"
                                            Command="{Binding ApplyEqualizerPresetCommand}" CommandParameter="Classical" />
                                    <Button Style="{StaticResource PillButtonStyle}" Content="Night" Margin="0,0,8,8"
                                            Command="{Binding ApplyEqualizerPresetCommand}" CommandParameter="Night" />
                                </WrapPanel>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                            BorderThickness="1" CornerRadius="14" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="PREAMP" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <Slider Minimum="-12" Maximum="12" Value="{Binding EqualizerPreampDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Style="{StaticResource PlayerSliderStyle}" IsMoveToPointEnabled="True" SmallChange="0.5" LargeChange="2" />
                                                <TextBlock Grid.Column="1" Text="{Binding EqualizerPreampText}" Style="{StaticResource CaptionStyle}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                            BorderThickness="1" CornerRadius="14" Padding="14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="CLIPPING PROTECTION" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding EqualizerEffectivePreampText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
                                            </StackPanel>
                                            <ToggleButton Grid.Column="1" Style="{StaticResource ChipToggleStyle}"
                                                          IsChecked="{Binding IsEqualizerAutoHeadroomEnabled, Mode=OneWay}"
                                                          Command="{Binding ToggleEqualizerHeadroomCommand}"
                                                          Content="{Binding EqualizerHeadroomLabel}" />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <TextBlock Text="BANDS" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Margin="2,18,0,8" />
                                <ItemsControl ItemsSource="{Binding EqualizerBands}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EqualizerBandViewModel}">
                                            <Border Width="330" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                                    BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,10,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="54" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="68" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <Slider Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding GainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Style="{StaticResource PlayerSliderStyle}" IsMoveToPointEnabled="True" SmallChange="0.5" LargeChange="2" Margin="8,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding GainText}" Style="{StaticResource CaptionStyle}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Equalizer settings are saved with the session and are applied to every supported audio format. Auto headroom lowers the effective preamp by the strongest positive band boost; a final limiter protects the output when headroom is disabled."
                                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="2,8,2,4" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Player dock -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="20,16" BorderBrush="{DynamicResource AccentBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="68" Height="68" CornerRadius="16" Background="{DynamicResource AlbumArtPlaceholderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Image Source="Assets/cadence-studio-icon-256.png" Width="36" Height="36" Opacity="0.52" Stretch="Uniform" />
                                        <Border CornerRadius="15">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding NowPlayingArtwork, Converter={StaticResource AlbumArtConverter}}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NowPlayingTitle}" FontFamily="{DynamicResource AppDisplayFontFamily}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding NowPlayingArtist}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="1" Margin="28,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="72" />
                                    <RowDefinition Height="32" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Style="{StaticResource TransportButtonStyle}" Content="|◀" Command="{Binding PreviousCommand}" ToolTip="Previous" />
                                    <Button Style="{StaticResource TransportButtonStyle}" Content="■" Command="{Binding StopPlaybackCommand}" Margin="12,0,0,0" ToolTip="Stop" />
                                    <Button Content="{Binding PlayPauseGlyph}" Command="{Binding TogglePlaybackCommand}" Margin="14,0" ToolTip="Play or pause">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PlayButtonStyle}">
                                                <Setter Property="Width" Value="66" />
                                                <Setter Property="Height" Value="66" />
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Style="{StaticResource TransportButtonStyle}" Content="▶|" Click="Next_Click" ToolTip="Next" />
                                    <Button Style="{StaticResource TransportModeButtonStyle}" Command="{Binding CycleRepeatCommand}" Margin="16,0,0,0" ToolTip="Cycle repeat mode">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="↻" FontFamily="Segoe UI Symbol" FontSize="17" FontWeight="Bold" Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RepeatLabel}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <ToggleButton Style="{StaticResource TransportModeToggleStyle}" IsChecked="{Binding IsShuffleEnabled, Mode=OneWay}" Command="{Binding ToggleShuffleCommand}" Margin="10,0,0,0" ToolTip="Toggle shuffle">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⤨" FontFamily="Segoe UI Symbol" FontSize="17" FontWeight="Bold" Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ShuffleLabel}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PositionText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding DurationSeconds}"
                                            Value="{Binding PositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding CanSeek}" IsMoveToPointEnabled="True"
                                            SmallChange="1" LargeChange="10"
                                            Style="{StaticResource PlayerSliderStyle}" Margin="8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Grid>

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Button Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15"
                                        Content="{Binding VolumeGlyph}" Command="{Binding ToggleMuteCommand}" Cursor="Hand" ToolTip="Mute or unmute" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsMoveToPointEnabled="True" SmallChange="0.01" LargeChange="0.05"
                                        Style="{StaticResource PlayerSliderStyle}" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding VolumePercentText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Separate from Cadence Classic" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
