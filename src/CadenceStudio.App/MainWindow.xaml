<Window x:Class="CadenceStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:CadenceStudio.App.ViewModels"
        xmlns:models="clr-namespace:CadenceStudio.Core.Models;assembly=CadenceStudio.Core"
        mc:Ignorable="d"
        Title="Cadence Studio"
        Icon="Assets/cadence-studio-icon-256.png"
        Width="1440"
        Height="900"
        MinWidth="1260"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{DynamicResource AppBodyFontFamily}"
        FontSize="{DynamicResource AppBodyFontSize}"
        FontWeight="Medium"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowDepthBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Grid.Row="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.34" /></Border.Effect>
                            <Image Source="Assets/cadence-studio-icon-256.png" Width="30" Height="30" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="CADENCE STUDIO" FontFamily="{DynamicResource AppDisplayFontFamily}" FontWeight="Bold" FontSize="16" />
                            <TextBlock Text="AUDIO EXPERIENCE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="11" Padding="9,4" Margin="14,0,0,0">
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionStyle}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowButtonStyle}" Content="?" Click="Shortcuts_Click" ToolTip="Keyboard shortcuts (F1 or Ctrl+/)" />
                        <Button Style="{StaticResource WindowButtonStyle}" Content="—" Click="Minimize_Click" />
                        <Button Style="{StaticResource WindowButtonStyle}" Content="□" Click="Maximize_Click" />
                        <Button Style="{StaticResource CloseWindowButtonStyle}" Content="×" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main workspace -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="246" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0">
                    <Grid Margin="14,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="YOUR MUSIC" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Margin="10,0,0,8" />
                            <ToggleButton Style="{StaticResource NavToggleButtonStyle}" IsChecked="{Binding IsLibraryActive, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Library">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▦" FontFamily="Segoe UI Symbol" Width="26" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" />
                                    <TextBlock Text="Library" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource NavToggleButtonStyle}" IsChecked="{Binding IsPlaylistsActive, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Playlists">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="≡" FontFamily="Segoe UI Symbol" Width="26" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" />
                                    <TextBlock Text="Playlists" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource NavToggleButtonStyle}" IsChecked="{Binding IsQueueActive, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Queue">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="☷" FontFamily="Segoe UI Symbol" Width="26" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" />
                                    <TextBlock Text="Queue" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,26,0,0">
                            <TextBlock Text="TOOLS" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Margin="10,0,0,8" />
                            <ToggleButton Style="{StaticResource NavToggleButtonStyle}" IsChecked="{Binding IsSettingsActive, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontFamily="Segoe UI Symbol" Width="26" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" />
                                    <TextBlock Text="Settings" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1" Margin="22,18,22,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="154" />
                    </Grid.RowDefinitions>

                    <Border Margin="2,0,2,18" Padding="18,13" CornerRadius="16" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity="0.30" /></Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveSection}" FontFamily="{DynamicResource AppDisplayFontFamily}" FontSize="{DynamicResource AppPageTitleFontSize}" FontWeight="Bold" />
                                <TextBlock Text="{Binding SectionSubtitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource AppBodyFontSize}" FontWeight="Medium" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Width="460"
                                    MaxWidth="560"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource SearchBoxStyle}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LibrarySearchText}" Value="">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LibrarySearchText}" Value="{x:Null}">
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⌕"
                                               FontFamily="Segoe UI Symbol"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="17"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="GlobalSearchTextBox"
                                             Grid.Column="1"
                                             Style="{StaticResource SearchTextBoxStyle}"
                                             Text="{Binding LibrarySearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                             ToolTip="Search albums, artists, tracks, and genres"
                                             TextChanged="GlobalSearchTextBox_TextChanged"
                                             GotKeyboardFocus="GlobalSearchTextBox_GotKeyboardFocus"
                                             KeyDown="GlobalSearchTextBox_KeyDown" />
                                    <TextBlock Grid.Column="1"
                                               Text="Search albums, artists, tracks, genres…"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LibrarySearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Grid.Column="2"
                                            Width="24"
                                            Height="24"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            ToolTip="Clear global search"
                                            Click="ClearGlobalSearch_Click">
                                        <TextBlock Text="×" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LibrarySearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                            <Popup x:Name="GlobalSearchPopup"
                                   Grid.Column="2"
                                   PlacementTarget="{Binding ElementName=GlobalSearchTextBox}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   HorizontalOffset="-28"
                                   VerticalOffset="10">
                                <Border Width="560"
                                        MaxHeight="430"
                                        Padding="10"
                                        CornerRadius="14"
                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="10" Opacity="0.55" />
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="6,2,6,8">
                                            <TextBlock Text="SEARCH RESULTS"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="↑↓ navigate  •  click to play"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                        </DockPanel>
                                        <ListBox x:Name="GlobalSearchResultsList"
                                                 Grid.Row="1"
                                                 MaxHeight="370"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,2" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12,9"
                                                            CornerRadius="10"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            MouseLeftButtonUp="GlobalSearchResult_MouseLeftButtonUp">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="58" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="46" Height="24" CornerRadius="8"
                                                                    Background="{DynamicResource AccentSoftBrush}"
                                                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                                                <TextBlock Text="{Binding Kind}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Subtitle}" Margin="0,2,0,0" FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="▶" Margin="12,0,4,0" VerticalAlignment="Center"
                                                                       FontSize="16" Foreground="{DynamicResource AccentBrush}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border Grid.Row="1" Padding="18" Background="Transparent">
                                            <TextBlock Text="No matching artists, albums, tracks, or genres"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=GlobalSearchResultsList, Path=HasItems}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Popup>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="12,7" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding ThemeName}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,7">
                                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock Text="Playback online" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="LibraryWorkspaceGrid"
                          Grid.Row="1"
                          Visibility="{Binding IsLibraryActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <!-- Responsive library workspace:
                                 restored windows give Now Playing additional width, while maximized windows
                                 give the folder browser the wider 480 px presentation. -->
                            <ColumnDefinition x:Name="LibraryPanelColumn" Width="400" MinWidth="0" MaxWidth="530" />
                            <ColumnDefinition x:Name="LibraryNowPlayingSpacerColumn" Width="10" />
                            <ColumnDefinition x:Name="NowPlayingPanelColumn" Width="*" MinWidth="280" />
                            <ColumnDefinition x:Name="NowPlayingQueueSpacerColumn" Width="10" />
                            <ColumnDefinition x:Name="QueuePanelColumn" Width="365" />
                        </Grid.ColumnDefinitions>

                        <!-- Indexed library card -->
                        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Music library" Style="{StaticResource PanelTitleStyle}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,4,0,0">
                                            <Run Text="{Binding IndexedTrackCountText, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding LibraryFolderCountText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PillButtonStyle}" Padding="10,7"
                                            Content="Root" Command="{Binding AddLibraryRootCommand}" ToolTip="Add library root" />
                                    <Button Grid.Column="3" Style="{StaticResource AccentPillButtonStyle}" Padding="11,7"
                                            Content="Scan" Command="{Binding ScanLibraryCommand}" ToolTip="Rescan saved roots"
                                            Visibility="{Binding IsLibraryIdle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Grid.Column="3" Style="{StaticResource PillButtonStyle}" Padding="11,7"
                                            Content="Cancel scan" Command="{Binding CancelLibraryScanCommand}" ToolTip="Stop the active library scan"
                                            Visibility="{Binding IsLibraryScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>

                                <ListBox Grid.Row="1" ItemsSource="{Binding LibraryRoots}" SelectedItem="{Binding SelectedLibraryRoot}"
                                         Style="{StaticResource DarkListBoxStyle}" ItemContainerStyle="{StaticResource CompactListBoxItemStyle}"
                                         MaxHeight="70" Margin="0,12,0,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="18" Height="18" CornerRadius="5" Background="{DynamicResource SurfaceHoverBrush}">
                                                    <TextBlock Text="♪" FontFamily="Segoe UI Symbol" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Row="2" Style="{StaticResource SearchBoxStyle}" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⌕" FontFamily="Segoe UI Symbol" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBox x:Name="LibrarySearchTextBox" Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding LibrarySearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                                 ToolTip="Search folders, filenames, title, artist, album, genre, or path" />
                                        <TextBlock Grid.Column="1" Text="Search library…" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LibrarySearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="3" Margin="0,10,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding LibraryScanStatus}" Style="{StaticResource CaptionStyle}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding LibraryScanStatus}" />
                                    <ProgressBar Grid.Row="1" Style="{StaticResource LibraryProgressBarStyle}"
                                                 Maximum="{Binding LibraryScanProgressMaximum, Mode=OneWay}" Value="{Binding LibraryScanFilesProcessed, Mode=OneWay}"
                                                 IsIndeterminate="{Binding LibraryScanProgressIsIndeterminate, Mode=OneWay}" Margin="0,7,0,0" />
                                </Grid>

                                <Grid Grid.Row="4">
                                    <TreeView ItemsSource="{Binding LibraryFolders}" Style="{StaticResource DarkTreeViewStyle}"
                                              VirtualizingStackPanel.IsVirtualizing="True"
                                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.PanningMode="Both">
                                        <TreeView.Resources>
                                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource DarkTreeViewItemStyle}" />
                                            <HierarchicalDataTemplate DataType="{x:Type vm:LibraryFolderNode}" ItemsSource="{Binding Children}">
                                                <Grid Margin="0,2,6,2" HorizontalAlignment="Left"
                                                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=TreeView}, Converter={StaticResource LibraryRowWidthConverter}, ConverterParameter=34}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel MinWidth="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionStyle}" FontSize="10" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource TreeActionButtonStyle}" Content="＋"
                                                            Command="{Binding DataContext.AddLibraryFolderCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                            CommandParameter="{Binding}" ToolTip="Add this folder and all subfolders to the queue" />
                                                    <Button Grid.Column="2" Style="{StaticResource TreeActionButtonStyle}" Content="▶"
                                                            Command="{Binding DataContext.PlayLibraryFolderCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                            CommandParameter="{Binding}" ToolTip="Play this folder and all subfolders" />
                                                    <Button Grid.Column="3" Style="{StaticResource TreeActionButtonStyle}" Content="P"
                                                            Command="{Binding DataContext.AddLibraryFolderToPlaylistCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                            CommandParameter="{Binding}" ToolTip="Add this folder and all subfolders to the selected playlist" />
                                                </Grid>
                                            </HierarchicalDataTemplate>

                                            <DataTemplate DataType="{x:Type models:Track}">
                                                <Grid Margin="0,1,6,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TrackNumber}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,7,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" TextWrapping="NoWrap" ToolTip="{Binding FilePath}" FontSize="12" />
                                                        <TextBlock Text="{Binding FormatDescription}" Style="{StaticResource CaptionStyle}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource CaptionStyle}" FontSize="10" VerticalAlignment="Center" Margin="6,0" />
                                                    <Button Grid.Column="3" Style="{StaticResource TreeActionButtonStyle}" Content="＋"
                                                            Command="{Binding DataContext.AddLibraryTrackCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                            CommandParameter="{Binding}" ToolTip="Add track to queue" />
                                                    <Button Grid.Column="4" Style="{StaticResource TreeActionButtonStyle}" Content="▶"
                                                            Command="{Binding DataContext.PlayLibraryTrackCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                            CommandParameter="{Binding}" ToolTip="Play track" />
                                                    <Button Grid.Column="5" Style="{StaticResource TreeActionButtonStyle}" Content="P"
                                                            Command="{Binding DataContext.AddLibraryTrackToPlaylistCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                            CommandParameter="{Binding}" ToolTip="Add track to selected playlist" />
                                                </Grid>
                                            </DataTemplate>
                                        </TreeView.Resources>
                                    </TreeView>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.75">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LibraryFolders.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="▦" FontFamily="Segoe UI Symbol" FontSize="30" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No indexed folders in this view" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,8,0,0" />
                                        <TextBlock Text="Add a root, scan, or clear the search" Style="{StaticResource CaptionStyle}" TextAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="5" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LibraryLastScanText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" Style="{StaticResource PillButtonStyle}" Padding="10,6" Content="Remove root" Command="{Binding RemoveLibraryRootCommand}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Now playing card -->
                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Now playing" Style="{StaticResource PanelTitleStyle}" />
                                        <TextBlock Text="{Binding PlaybackStatusText}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="11" Padding="10,5">
                                        <TextBlock Text="STABLE RELEASE" FontFamily="{DynamicResource AppTechnicalFontFamily}" FontSize="{DynamicResource AppSmallFontSize}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <Button Grid.Column="3"
                                            Content="{Binding NowPlayingModeLabel}"
                                            Command="{Binding ToggleNowPlayingModeCommand}"
                                            Click="NowPlayingMode_Click"
                                            ToolTip="Toggle compact and expanded Now Playing modes">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FocusModeButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNowPlayingExpanded}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlActiveBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Slim split-pill: one shell, one divider, two hit targets. -->
                                    <Border Grid.Column="5"
                                            Height="34"
                                            MinWidth="168"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource SurfaceRaisedBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="32"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="WindowVisualizerLaunchButton"
                                                    Grid.Column="0"
                                                    Content="Window Visualizer"
                                                    Click="OpenWindowVisualizer_Click"
                                                    Padding="13,0,11,0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Cursor="Hand"
                                                    ToolTip="Open the Window Visualizer in the last-used mode (Ctrl+Shift+V)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="LaunchSurface" Background="{TemplateBinding Background}" CornerRadius="9,0,0,9">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                              Margin="{TemplateBinding Padding}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="LaunchSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="LaunchSurface" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Border Grid.Column="1" Width="1" HorizontalAlignment="Left" Margin="0,7" Background="{DynamicResource BorderBrush}"/>
                                            <Button x:Name="WindowVisualizerMenuButton"
                                                    Grid.Column="1"
                                                    Content="▾"
                                                    Click="WindowVisualizerMenu_Click"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Cursor="Hand"
                                                    ToolTip="Choose Window Visualizer mode">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="MenuSurface" Background="{TemplateBinding Background}" CornerRadius="0,9,9,0">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.ContextMenu>
                                                    <ContextMenu Placement="Bottom">
                                                        <MenuItem Header="Open pop-out" Click="OpenWindowVisualizerPopOut_Click"/>
                                                        <MenuItem Header="Open floating" Click="OpenWindowVisualizerFloating_Click"/>
                                                        <MenuItem Header="Open fullscreen" Click="OpenWindowVisualizerFullscreen_Click"/>
                                                        <Separator/>
                                                        <MenuItem Header="Bring to front" Click="BringWindowVisualizerToFront_Click"/>
                                                        <MenuItem Header="Close Window Visualizer" Click="CloseWindowVisualizer_Click"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Compact practical layout: Library and Queue remain visible. -->
                                <Grid x:Name="CompactNowPlayingView" Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNowPlayingExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="320" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition x:Name="EnrichmentPanelColumn" Width="304" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="278" />
                                        </Grid.RowDefinitions>

                                        <Grid VerticalAlignment="Stretch" ClipToBounds="True">
                                            <!-- Compact album ambience fills the upper stage without competing with the track details. -->
                                            <Border Opacity="0.15" IsHitTestVisible="False" Margin="2" CornerRadius="16">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding NowPlayingArtwork, Converter={StaticResource AlbumArtConverter}}"
                                                                Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                                </Border.Background>
                                                <Border.Effect><BlurEffect Radius="42" /></Border.Effect>
                                            </Border>
                                            <Border IsHitTestVisible="False" Margin="2" CornerRadius="16">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#16000000" Offset="0" />
                                                        <GradientStop Color="#9A000000" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Grid VerticalAlignment="Center" Margin="0,-10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border x:Name="NowPlayingArtworkBorder" Width="224" Height="224" MaxWidth="270" MaxHeight="270"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"
                                                    Background="{DynamicResource AlbumArtPlaceholderBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20"
                                                    ClipToBounds="False">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="7" Opacity="0.58" />
                                                </Border.Effect>
                                                <Grid>
                                                    <Image Source="Assets/cadence-studio-icon-256.png" Width="112" Height="112"
                                                           Opacity="0.42" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <Border x:Name="CompactArtworkSurface" CornerRadius="19" ClipToBounds="True">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding NowPlayingArtwork, Converter={StaticResource AlbumArtConverter}}"
                                                                        Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                                        </Border.Background>
                                                    </Border>
                                                    <Border CornerRadius="19" BorderBrush="#32FFFFFF" BorderThickness="1" Margin="1" IsHitTestVisible="False" />
                                                    <Border VerticalAlignment="Bottom" Background="#D10A0D12" CornerRadius="0,0,19,19" Padding="14,8">
                                                        <TextBlock Text="{Binding NowPlayingArtworkSource}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="1" Margin="18,10,18,4" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding NowPlayingTitle}" FontFamily="{DynamicResource AppDisplayFontFamily}" FontSize="25" FontWeight="Bold"
                                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding NowPlayingTitle}" />
                                                <TextBlock Text="{Binding NowPlayingArtist}" Foreground="{DynamicResource AccentBrush}" FontSize="15" FontWeight="SemiBold"
                                                           Margin="0,5,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding NowPlayingArtist}" />
                                                <TextBlock Text="{Binding NowPlayingAlbum}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                                           Margin="0,3,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding NowPlayingAlbum}" />
                                                <TextBlock Text="{Binding NowPlayingMetadata}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"
                                                           Margin="0,5,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding NowPlayingFormat}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"
                                                           Margin="0,4,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="14" Padding="12,9">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="8,7">
                                                    <Grid>
                                                        <Border Height="1" VerticalAlignment="Bottom" Margin="0,0,0,2" Background="#38414D" Opacity="0.85" />
                                                        <ItemsControl ItemsSource="{Binding VisualizerBars}" Height="176" VerticalAlignment="Bottom"
                                                                      IsHitTestVisible="False" SnapsToDevicePixels="True">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:VisualizerBarViewModel}">
                                                                    <Grid Margin="2,0">
                                                                        <Border Height="{Binding Height}" VerticalAlignment="Bottom" Background="{Binding Fill}"
                                                                                CornerRadius="3,3,1,1" MinHeight="6" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>
                                                <Grid Grid.Row="1" Margin="0,7,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1" CornerRadius="9" Padding="7,2" Margin="0,0,7,0">
                                                            <TextBlock Text="LIVE" FontSize="9" FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding VisualizerActivityText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding VisualizerDensityText}" Style="{StaticResource CaptionStyle}" Margin="0,0,9,0" />
                                                        <Button Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}"
                                                                FontSize="10" Cursor="Hand" Content="{Binding VisualizerLabel}"
                                                                Command="{Binding CycleVisualizerCommand}" ToolTip="Cycle the visualizer palette" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="16" Padding="16,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="NOW PLAYING INSIGHTS" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <Grid Grid.Row="1" Margin="0,9,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Style="{StaticResource InfoTabToggleStyle}" Content="DETAILS" IsChecked="{Binding IsDetailsTabActive, Mode=OneWay}" Command="{Binding SelectNowPlayingTabCommand}" CommandParameter="Details" />
                                                <ToggleButton Grid.Column="1" Style="{StaticResource InfoTabToggleStyle}" Content="LYRICS" IsChecked="{Binding IsLyricsTabActive, Mode=OneWay}" Command="{Binding SelectNowPlayingTabCommand}" CommandParameter="Lyrics" />
                                                <ToggleButton Grid.Column="2" Style="{StaticResource InfoTabToggleStyle}" Content="BIO" IsChecked="{Binding IsBioTabActive, Mode=OneWay}" Command="{Binding SelectNowPlayingTabCommand}" CommandParameter="Bio" />
                                            </Grid>
                                            <Grid x:Name="CompactInsightContent" Grid.Row="2" Margin="0,6,0,8">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <TextBlock Text="{Binding NowPlayingDetailsText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" LineHeight="18">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsDetailsTabActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </ScrollViewer>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLyricsTabActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                                                    <Border Style="{StaticResource LyricsPanelStyle}">
                                                        <StackPanel>
                                                            <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="LYRICS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" /><Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7,2"><TextBlock Text="{Binding LyricsSourceText}" Style="{StaticResource CaptionStyle}" /></Border></Grid>
                                                            <TextBlock Text="{Binding LyricsText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource AppBodyFontSize}" FontWeight="Medium" LineHeight="24" />
                                                        </StackPanel>
                                                    </Border>
                                                </ScrollViewer>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsBioTabActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                                                    <TextBlock Text="{Binding ArtistBioText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" LineHeight="19" />
                                                </ScrollViewer>
                                                <Border Style="{StaticResource InsightLoadingOverlayStyle}" Panel.ZIndex="20">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="180">
                                                        <TextBlock Text="Finding track insights…" FontWeight="SemiBold" TextAlignment="Center" />
                                                        <TextBlock Text="MusicBrainz, lyrics, and artist data" Style="{StaticResource CaptionStyle}" TextAlignment="Center" Margin="0,5,0,10" />
                                                        <ProgressBar IsIndeterminate="True" Height="4" Style="{StaticResource LibraryProgressBarStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Grid Grid.Row="3">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                                            <Setter Property="Text" Value="{Binding MusicBrainzStatus}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLyricsTabActive}" Value="True"><Setter Property="Text" Value="{Binding LyricsSourceText}" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding IsBioTabActive}" Value="True"><Setter Property="Text" Value="{Binding BioSourceText}" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Grid Grid.Row="1" Margin="0,7,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding EnrichmentStatus}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EnrichmentStatus}" />
                                                    <Button Grid.Column="1" Style="{StaticResource PillButtonStyle}" Padding="8,4" Content="Refresh" Command="{Binding RefreshEnrichmentCommand}" Margin="8,0,0,0" ToolTip="Refresh MusicBrainz, lyrics, and artist biography" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Expanded artwork-led focus layout. Library and Queue collapse while this view is active. -->
                                <Grid x:Name="ExpandedNowPlayingView" Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding IsNowPlayingExpanded}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition x:Name="ExpandedEnrichmentPanelColumn" Width="390" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="20" Padding="18" ClipToBounds="True">
                                        <Grid>
                                            <!-- Album-art ambience turns the expanded workspace into a true Now Playing stage. -->
                                            <Border Margin="-40,-40,-40,360" Opacity="0.30" IsHitTestVisible="False">
                                                <Border.Effect><BlurEffect Radius="72" /></Border.Effect>
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding NowPlayingArtwork, Converter={StaticResource AlbumArtConverter}}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="-18" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="0.30,0.20" GradientOrigin="0.30,0.20" RadiusX="0.88" RadiusY="0.88">
                                                        <GradientStop Color="#08FFFFFF" Offset="0" />
                                                        <GradientStop Color="#C6080C12" Offset="0.62" />
                                                        <GradientStop Color="#F0080C12" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Margin="-18" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="20" Opacity="0.24" IsHitTestVisible="False" />

                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Grid MinHeight="318">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border x:Name="ExpandedNowPlayingArtworkBorder" Width="306" Height="306" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="{DynamicResource AlbumArtPlaceholderBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="28">
                                                        <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="44" ShadowDepth="12" Opacity="0.78" /></Border.Effect>
                                                        <Grid>
                                                            <Border CornerRadius="28" Background="{DynamicResource AccentBrush}" Opacity="0.10" Margin="-10" />
                                                            <Image Source="Assets/cadence-studio-icon-256.png" Width="132" Height="132" Opacity="0.28" Stretch="Uniform" />
                                                            <Border x:Name="ExpandedArtworkSurface" CornerRadius="27" ClipToBounds="True"><Border.Background><ImageBrush ImageSource="{Binding NowPlayingArtwork, Converter={StaticResource AlbumArtConverter}}" Stretch="UniformToFill" /></Border.Background></Border>
                                                            <Border CornerRadius="27" BorderBrush="#66FFFFFF" BorderThickness="1" Margin="1" />
                                                            <Border CornerRadius="27" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Opacity="0.34" />
                                                            <Border VerticalAlignment="Bottom" Background="#E1080B10" CornerRadius="0,0,27,27" Padding="14,10">
                                                                <TextBlock Text="{Binding NowPlayingArtworkSource}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="760">
                                                        <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="11,5" HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" /><TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" /></StackPanel>
                                                        </Border>
                                                        <TextBlock Text="{Binding NowPlayingTitle}" FontFamily="{DynamicResource AppDisplayFontFamily}" FontSize="38" FontWeight="Bold" Margin="0,20,0,0" TextWrapping="Wrap" ToolTip="{Binding NowPlayingTitle}">
                                                            <TextBlock.Effect><DropShadowEffect Color="#AA000000" BlurRadius="18" ShadowDepth="3" Opacity="0.75" /></TextBlock.Effect>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding NowPlayingArtist}" Foreground="{DynamicResource AccentBrush}" FontSize="21" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding NowPlayingAlbum}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" FontStyle="Italic" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                                                        <WrapPanel Margin="0,20,0,0">
                                                            <Border Style="{StaticResource HeroMetadataChipStyle}"><TextBlock Text="{Binding NowPlayingMetadata}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
                                                            <Border Style="{StaticResource HeroMetadataChipStyle}"><TextBlock Text="{Binding NowPlayingFormat}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
                                                        </WrapPanel>
                                                        <Border Height="3" Width="180" HorizontalAlignment="Left" Margin="0,22,0,0" CornerRadius="2" Background="{DynamicResource AccentBrush}" Opacity="0.70">
                                                            <Border.Effect><DropShadowEffect Color="#9900FFFF" BlurRadius="12" ShadowDepth="0" Opacity="0.55" /></Border.Effect>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                            <Border x:Name="ExpandedVisualizerBorder" Grid.Row="2" Height="236" Background="{DynamicResource PremiumCardBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="19" Padding="16,12" ClipToBounds="True">
                                                <Border.Effect><DropShadowEffect Color="#6600FFFF" BlurRadius="34" ShadowDepth="0" Opacity="0.38" /></Border.Effect>
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                                                    <!-- Deep reactive stage: layered atmosphere, frequency zones, particles, mirrored energy. -->
                                                    <Border CornerRadius="16" IsHitTestVisible="False">
                                                        <Border.Background>
                                                            <RadialGradientBrush Center="0.50,0.50" GradientOrigin="0.50,0.50" RadiusX="0.80" RadiusY="1.10">
                                                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                                                                <GradientStop Color="#32121A24" Offset="0.34" />
                                                                <GradientStop Color="#F306090D" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Border.Background>
                                                        <Border.Opacity>0.30</Border.Opacity>
                                                    </Border>

                                                    <Grid Margin="5,3,5,0" ClipToBounds="True">
                                                        <Border IsHitTestVisible="False" Opacity="0.62">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#20C16D32" Offset="0" />
                                                                    <GradientStop Color="#1600BDB5" Offset="0.48" />
                                                                    <GradientStop Color="#247C6BDF" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Border.Effect><BlurEffect Radius="28" /></Border.Effect>
                                                        </Border>
                                                        <!-- Subtle frequency-zone columns. -->
                                                        <Grid Opacity="0.18" IsHitTestVisible="False">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="4*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Background="#44B14928" />
                                                            <Border Grid.Column="1" Background="#448B5A24" />
                                                            <Border Grid.Column="2" Background="#445E536E" />
                                                            <Border Grid.Column="3" Background="#443A7180" />
                                                            <Border Grid.Column="4" Background="#44485E99" />
                                                            <Border Grid.Column="5" Background="#446B5A9A" />
                                                            <Border Grid.Column="6" Background="#447A8CA8" />
                                                        </Grid>

                                                        <!-- Fine horizon guides. -->
                                                        <Grid IsHitTestVisible="False" Opacity="0.18">
                                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                                            <Border Grid.Row="0" Height="1" Background="#66FFFFFF" VerticalAlignment="Bottom" />
                                                            <Border Grid.Row="1" Height="1" Background="#55FFFFFF" VerticalAlignment="Bottom" />
                                                            <Border Grid.Row="2" Height="1" Background="#44FFFFFF" VerticalAlignment="Bottom" />
                                                            <Border Grid.Row="3" Height="1" Background="#33FFFFFF" VerticalAlignment="Bottom" />
                                                        </Grid>

                                                        <!-- Decorative particles, restrained and theme-responsive. -->
                                                        <Canvas IsHitTestVisible="False" Opacity="0.52">
                                                            <Ellipse Canvas.Left="62" Canvas.Top="28" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" />
                                                            <Ellipse Canvas.Left="148" Canvas.Top="76" Width="3" Height="3" Fill="#CCFFFFFF" />
                                                            <Ellipse Canvas.Left="268" Canvas.Top="34" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" />
                                                            <Ellipse Canvas.Left="416" Canvas.Top="92" Width="3" Height="3" Fill="#AAFFFFFF" />
                                                            <Ellipse Canvas.Right="344" Canvas.Top="44" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" />
                                                            <Ellipse Canvas.Right="214" Canvas.Top="82" Width="3" Height="3" Fill="#CCFFFFFF" />
                                                            <Ellipse Canvas.Right="76" Canvas.Top="30" Width="5" Height="5" Fill="{DynamicResource AccentBrush}" />
                                                        </Canvas>

                                                        <!-- Outer pulse rings around the central energy node. -->
                                                        <Ellipse Width="118" Height="118" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0.18" IsHitTestVisible="False" />
                                                        <Ellipse Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#99FFFFFF" StrokeThickness="1" Opacity="0.15" IsHitTestVisible="False" />
                                                        <Border Height="2" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" Opacity="0.48" IsHitTestVisible="False">
                                                            <Border.Effect><DropShadowEffect Color="#CCFFFFFF" BlurRadius="16" ShadowDepth="0" Opacity="0.72" /></Border.Effect>
                                                        </Border>

                                                        <!-- Broad glow layer behind the live spectrum. -->
                                                        <ItemsControl ItemsSource="{Binding VisualizerBars}" Height="164" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.20">
                                                            <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsSpectrumHorizonMode}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:VisualizerBarViewModel}">
                                                                    <Grid Margin="1,0">
                                                                        <Border Height="{Binding ExpandedHeight}" VerticalAlignment="Center" Background="{Binding ExpandedFill}" CornerRadius="8" MinHeight="10">
                                                                            <Border.Effect><BlurEffect Radius="8" /></Border.Effect>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Main frequency bars. -->
                                                        <ItemsControl x:Name="ExpandedVisualizerBars" ItemsSource="{Binding VisualizerBars}" Height="158" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True">
                                                            <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsSpectrumHorizonMode}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:VisualizerBarViewModel}">
                                                                    <Grid Margin="2,0">
                                                                        <Border Height="{Binding ExpandedHeight}" VerticalAlignment="Center" Background="{Binding ExpandedFill}" CornerRadius="6" MinHeight="8">
                                                                            <Border.Effect><DropShadowEffect Color="#AA00FFFF" BlurRadius="12" ShadowDepth="0" Opacity="0.72" /></Border.Effect>
                                                                        </Border>
                                                                        <Border Height="2" VerticalAlignment="Center" Background="#CCFFFFFF" CornerRadius="1" Opacity="0.38" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Mirrored spectral reflection: restrained depth beneath the live bars. -->
                                                        <ItemsControl ItemsSource="{Binding VisualizerBars}" Height="72" VerticalAlignment="Center" Margin="0,74,0,0" IsHitTestVisible="False" Opacity="0.16" RenderTransformOrigin="0.5,0.5">
                                                            <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsSpectrumHorizonMode}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                                                            <ItemsControl.RenderTransform><ScaleTransform ScaleY="-0.72" /></ItemsControl.RenderTransform>
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:VisualizerBarViewModel}">
                                                                    <Grid Margin="2,0">
                                                                        <Border Height="{Binding ExpandedHeight}" VerticalAlignment="Top" Background="{Binding ExpandedFill}" CornerRadius="5" MinHeight="6">
                                                                            <Border.Effect><BlurEffect Radius="4" /></Border.Effect>
                                                                        </Border>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <!-- Mirrored Waveform mode: symmetric energy rising above and below the center line. -->
                                                        <Grid Height="166" VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsMirroredWaveformMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                            <ItemsControl Grid.Row="0" ItemsSource="{Binding VisualizerBars}" VerticalAlignment="Bottom" Height="80" Opacity="0.96">
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:VisualizerBarViewModel}"><Grid Margin="2,0"><Border Height="{Binding ExpandedHeight}" MaxHeight="76" VerticalAlignment="Bottom" Background="{Binding ExpandedFill}" CornerRadius="5,5,2,2"><Border.Effect><DropShadowEffect Color="#AA00FFFF" BlurRadius="11" ShadowDepth="0" Opacity="0.70"/></Border.Effect></Border></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding VisualizerBars}" VerticalAlignment="Top" Height="80" Opacity="0.70" RenderTransformOrigin="0.5,0">
                                                                <ItemsControl.RenderTransform><ScaleTransform ScaleY="-1"/></ItemsControl.RenderTransform>
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:VisualizerBarViewModel}"><Grid Margin="2,0"><Border Height="{Binding ExpandedHeight}" MaxHeight="76" VerticalAlignment="Top" Background="{Binding ExpandedFill}" CornerRadius="5,5,2,2"><Border.Effect><BlurEffect Radius="1.5"/></Border.Effect></Border></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Border Grid.RowSpan="2" Height="2" VerticalAlignment="Center" Background="#E6FFFFFF"><Border.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/></Border.Effect></Border>
                                                        </Grid>

                                                        <!-- Central pulse core. -->
                                                        <Ellipse Width="28" Height="28" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.22" IsHitTestVisible="False">
                                                            <Ellipse.Effect><BlurEffect Radius="12" /></Ellipse.Effect>
                                                        </Ellipse>
                                                        <Ellipse Width="13" Height="13" Fill="#FFFFFFFF" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <Ellipse.Effect><DropShadowEffect Color="#FFFFFFFF" BlurRadius="24" ShadowDepth="0" Opacity="1" /></Ellipse.Effect>
                                                        </Ellipse>

                                                        <!-- Mixing-oriented band labels. -->
                                                        <Grid VerticalAlignment="Bottom" Margin="8,0,8,4" IsHitTestVisible="False">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="4*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="SUB" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="BASS" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="LOW MID" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="3" Text="MID" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="4" Text="UPPER MID" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="5" Text="PRESENCE" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                                                            <TextBlock Grid.Column="6" Text="BRILLIANCE" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" />
                                                        </Grid>
                                                    </Grid>

                                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="9" Padding="8,3" Margin="0,0,8,0"><TextBlock Text="LIVE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /></Border>
                                                            <TextBlock Text="7-band musical response" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                                            <TextBlock Text="•" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="0,0,9,0" />
                                                            <TextBlock Text="adaptive smoothing" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ToggleButton Style="{StaticResource InfoTabToggleStyle}" Content="HORIZON" IsChecked="{Binding IsSpectrumHorizonMode, Mode=OneWay}" Command="{Binding SetNowPlayingVisualizerModeCommand}" CommandParameter="SpectrumHorizon" Margin="0,0,6,0"/>
                                                            <ToggleButton Style="{StaticResource InfoTabToggleStyle}" Content="MIRRORED" IsChecked="{Binding IsMirroredWaveformMode, Mode=OneWay}" Command="{Binding SetNowPlayingVisualizerModeCommand}" CommandParameter="MirroredWaveform" Margin="0,0,12,0"/>
                                                            <TextBlock Text="{Binding VisualizerDensityText}" Style="{StaticResource CaptionStyle}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                            <Button Style="{StaticResource TextButtonStyle}" Content="{Binding VisualizerLabel}" Command="{Binding CycleVisualizerCommand}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!-- Expanded horizontal queue: a taller artwork-led rail beneath the visualizer. -->
                                            <Border x:Name="ExpandedQueueBorder" Grid.Row="4" Height="190" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="16,14">
                                                <Grid>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="Up next" FontSize="15" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding QueueCountText}" Style="{StaticResource CaptionStyle}" Margin="10,2,0,0" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource UtilityPillButtonStyle}" Content="Clear" Command="{Binding ClearQueueCommand}" Padding="11,5" />
                                                    </Grid>

                                                    <Grid Grid.Row="2">
                                                        <ListBox x:Name="ExpandedHorizontalQueueListBox"
                                                                 ItemsSource="{Binding QueueView}"
                                                                 SelectedItem="{Binding SelectedQueueTrack}"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Height="138"
                                                                 Padding="0"
                                                                 AllowDrop="True"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                                 ScrollViewer.CanContentScroll="True"
                                                                 PreviewMouseWheel="HorizontalQueue_PreviewMouseWheel"
                                                                 PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown"
                                                                 PreviewMouseLeftButtonUp="QueueList_PreviewMouseLeftButtonUp"
                                                                 PreviewMouseMove="QueueList_PreviewMouseMove"
                                                                 DragOver="QueueList_DragOver"
                                                                 Drop="QueueList_Drop"
                                                                 ItemContainerStyle="{StaticResource ExpandedQueueCardItemStyle}">
                                                            <ListBox.ItemsPanel>
                                                                <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                            </ListBox.ItemsPanel>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Loaded="QueueCard_Loaded">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="⋮⋮" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="SizeAll" ToolTip="Drag to reorder" />
                                                                        <Border Grid.Column="1" Width="82" Height="82" CornerRadius="14" Background="{DynamicResource AlbumArtPlaceholderBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                                            <Border.Effect><DropShadowEffect Color="#77000000" BlurRadius="16" ShadowDepth="5" Opacity="0.70" /></Border.Effect>
                                                                            <Grid>
                                                                                <Image Source="Assets/cadence-studio-icon-256.png" Width="42" Height="42" Opacity="0.40" Stretch="Uniform" />
                                                                                <Border CornerRadius="12"><Border.Background><ImageBrush ImageSource="{Binding ArtworkBytes, Converter={StaticResource AlbumArtConverter}}" Stretch="UniformToFill" /></Border.Background></Border>
                                                                            </Grid>
                                                                        </Border>
                                                                        <StackPanel Grid.Column="2" Margin="10,0,8,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="{DynamicResource AppQueueTitleFontSize}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                                            <TextBlock Text="{Binding Artist}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Artist}" />
                                                                            <TextBlock Text="{Binding Album}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Album}" />
                                                                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                                            <Button Style="{StaticResource TreeActionButtonStyle}" Content="▶" Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Play track" />
                                                                            <Button Style="{StaticResource TreeActionButtonStyle}" Content="×" Margin="0,8,0,0" Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Remove from queue" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>

                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Queue.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="Queue is empty" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Add music from Library or Playlists" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="18,16">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <TextBlock Text="Now Playing insights" FontSize="16" FontWeight="SemiBold" />
                                            <Grid Grid.Row="1" Margin="0,12,0,12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <ToggleButton Style="{StaticResource InfoTabToggleStyle}" Content="DETAILS" IsChecked="{Binding IsDetailsTabActive, Mode=OneWay}" Command="{Binding SelectNowPlayingTabCommand}" CommandParameter="Details" />
                                                <ToggleButton Grid.Column="1" Style="{StaticResource InfoTabToggleStyle}" Content="LYRICS" IsChecked="{Binding IsLyricsTabActive, Mode=OneWay}" Command="{Binding SelectNowPlayingTabCommand}" CommandParameter="Lyrics" />
                                                <ToggleButton Grid.Column="2" Style="{StaticResource InfoTabToggleStyle}" Content="BIO" IsChecked="{Binding IsBioTabActive, Mode=OneWay}" Command="{Binding SelectNowPlayingTabCommand}" CommandParameter="Bio" />
                                            </Grid>
                                            <Grid x:Name="ExpandedInsightContent" Grid.Row="2" Margin="2,0,2,8">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <TextBlock Text="{Binding NowPlayingDetailsText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" LineHeight="22">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsDetailsTabActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </ScrollViewer>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLyricsTabActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                                                    <Border Style="{StaticResource LyricsPanelStyle}" Padding="16,14">
                                                        <StackPanel>
                                                            <Border Height="2" Margin="0,0,0,12" CornerRadius="1" Background="{DynamicResource AccentBrush}" Opacity="0.70" />
                                                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="LYRICS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" /><Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3"><TextBlock Text="{Binding LyricsSourceText}" Style="{StaticResource CaptionStyle}" /></Border></Grid>
                                                            <TextBlock Text="{Binding LyricsText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource AppLyricsFontSize}" FontWeight="Medium" LineHeight="{DynamicResource AppLyricsLineHeight}" TextAlignment="Center" Padding="8,4" />
                                                        </StackPanel>
                                                    </Border>
                                                </ScrollViewer>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsBioTabActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                                                    <TextBlock Text="{Binding ArtistBioText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" LineHeight="21" Padding="6,2" />
                                                </ScrollViewer>
                                                <Border Style="{StaticResource InsightLoadingOverlayStyle}" Panel.ZIndex="20">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="230">
                                                        <TextBlock Text="Finding track insights…" FontWeight="SemiBold" FontSize="14" TextAlignment="Center" />
                                                        <TextBlock Text="MusicBrainz, lyrics, artwork, and artist biography" Style="{StaticResource CaptionStyle}" TextAlignment="Center" Margin="0,6,0,12" />
                                                        <ProgressBar IsIndeterminate="True" Height="4" Style="{StaticResource LibraryProgressBarStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <Grid Grid.Row="3">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}"><Setter Property="Text" Value="{Binding MusicBrainzStatus}" /><Style.Triggers><DataTrigger Binding="{Binding IsLyricsTabActive}" Value="True"><Setter Property="Text" Value="{Binding LyricsSourceText}" /></DataTrigger><DataTrigger Binding="{Binding IsBioTabActive}" Value="True"><Setter Property="Text" Value="{Binding BioSourceText}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                                <Grid Grid.Row="1" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding EnrichmentStatus}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" /><Button Grid.Column="1" Style="{StaticResource PillButtonStyle}" Padding="9,5" Content="Refresh" Command="{Binding RefreshEnrichmentCommand}" Margin="9,0,0,0" /></Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Queue card -->
                        <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Queue" Style="{StaticResource PanelTitleStyle}" />
                                        <TextBlock Text="{Binding QueueVisibleCountText}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource UtilityPillButtonStyle}" Content="Clear" Command="{Binding ClearQueueCommand}" />
                                </Grid>

                                <Border Grid.Row="1" Style="{StaticResource SearchBoxStyle}" Margin="0,16,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⌕" FontFamily="Segoe UI Symbol" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBox x:Name="CompactQueueSearchTextBox" Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding QueueSearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                                 ToolTip="Filter the queue by title, artist, album, or path" />
                                        <TextBlock Grid.Column="1" Text="Search queue…" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding QueueSearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding QueueArtworkProgressText}" Style="{StaticResource CaptionStyle}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding QueueArtworkStatus}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Padding="8,4" Margin="8,0,0,0"
                                                Content="Fetch art" Command="{Binding FetchQueueArtworkCommand}"
                                                ToolTip="Fetch missing artwork for the current queue">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsQueueArtworkLoading}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource PillButtonStyle}" Padding="8,4" Margin="8,0,0,0"
                                                Content="Cancel" Command="{Binding CancelQueueArtworkCommand}"
                                                ToolTip="Cancel queue artwork lookup"
                                                Visibility="{Binding IsQueueArtworkLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <ProgressBar Grid.Row="1" Style="{StaticResource LibraryProgressBarStyle}" Margin="0,6,0,0"
                                                 Maximum="{Binding QueueArtworkProgressMaximum, Mode=OneWay}"
                                                 Value="{Binding QueueArtworkTracksProcessed, Mode=OneWay}"
                                                 Visibility="{Binding IsQueueArtworkLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>

                                <Grid Grid.Row="3">
                                    <ListBox x:Name="CompactQueueListBox"
                                             ItemsSource="{Binding QueueView}"
                                             SelectedItem="{Binding SelectedQueueTrack}"
                                             Style="{StaticResource DarkListBoxStyle}"
                                             ItemContainerStyle="{StaticResource PolishedQueueListBoxItemStyle}"
                                             AllowDrop="True"
                                             PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown"
                                             PreviewMouseLeftButtonUp="QueueList_PreviewMouseLeftButtonUp"
                                             PreviewMouseMove="QueueList_PreviewMouseMove"
                                             DragOver="QueueList_DragOver"
                                             Drop="QueueList_Drop">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Loaded="QueueCard_Loaded">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14" />
                                                        <ColumnDefinition Width="38" />
                                                        <ColumnDefinition Width="*" MinWidth="92" />
                                                        <ColumnDefinition Width="42" />
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="⋮⋮" Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                                               ToolTip="Drag to reorder" Cursor="SizeAll" />
                                                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AlbumArtPlaceholderBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                        <Grid>
                                                            <Image Source="Assets/cadence-studio-icon-256.png" Width="18" Height="18" Opacity="0.48" Stretch="Uniform" />
                                                            <Border CornerRadius="7">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding ArtworkBytes, Converter={StaticResource AlbumArtConverter}}" Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                                                        <TextBlock Text="{Binding Artist}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Artist}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding DurationText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <Button Grid.Column="4" Style="{StaticResource PillButtonStyle}" Padding="6,4" MinWidth="30" Content="▶"
                                                            Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}" ToolTip="Play track" />
                                                    <Button Grid.Column="5" Style="{StaticResource TreeActionButtonStyle}" Content="×" Margin="2,0,0,0" MinWidth="28"
                                                            Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}" ToolTip="Remove track from queue" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Queue.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Style="{StaticResource EmptyStateGlyphStyle}">
                                            <TextBlock Text="☷" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Your queue is empty" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,12,0,0" />
                                        <TextBlock Text="Open one or more audio files to start playback"
                                                   Style="{StaticResource CaptionStyle}" TextAlignment="Center" TextWrapping="Wrap" Width="230" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="4" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource AccentPillButtonStyle}" Content="Open music" Command="{Binding OpenAudioFilesCommand}" />
                                    <Button Grid.Column="2" Style="{StaticResource PrimaryPillButtonStyle}" Content="Play selected" Command="{Binding PlaySelectedCommand}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Playlists workspace -->
                    <Grid Grid.Row="1" Visibility="{Binding IsPlaylistsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SecondaryWorkspaceCardStyle}" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Saved playlists" Style="{StaticResource PanelTitleStyle}" />
                                        <TextBlock Text="{Binding PlaylistVisibleCountText}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource UtilityPillButtonStyle}" Content="Import" Command="{Binding ImportPlaylistCommand}" ToolTip="Import an M3U or M3U8 playlist" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource SearchBoxStyle}">
                                        <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding PlaylistNameText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Name for a new playlist or rename the selected playlist" />
                                    </Border>
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource PrimaryPillButtonStyle}" Content="New playlist" Command="{Binding CreatePlaylistCommand}" />
                                        <Button Grid.Column="2" Style="{StaticResource UtilityPillButtonStyle}" Content="Save queue" Command="{Binding SaveQueueAsPlaylistCommand}" />
                                    </Grid>
                                </Grid>

                                <Border Grid.Row="2" Style="{StaticResource SearchBoxStyle}" Margin="0,12,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⌕" FontFamily="Segoe UI Symbol" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBox x:Name="PlaylistSearchTextBox" Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}"
                                                 Text="{Binding PlaylistSearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                        <TextBlock Grid.Column="1" Text="Search playlists…" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PlaylistSearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="3">
                                    <ListBox ItemsSource="{Binding PlaylistsView}" SelectedItem="{Binding SelectedPlaylist}"
                                             Style="{StaticResource DarkListBoxStyle}" ItemContainerStyle="{StaticResource DarkListBoxItemStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <TextBlock Text="≡" FontFamily="Segoe UI Symbol" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <TextBlock Text="{Binding TrackCountText}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Playlists.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="≡" FontFamily="Segoe UI Symbol" FontSize="28" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No saved playlists" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,10,0,0" />
                                        <TextBlock Text="Name one above, save the queue, or import M3U/M3U8" Style="{StaticResource CaptionStyle}" TextAlignment="Center" TextWrapping="Wrap" Width="250" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="4" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource UtilityPillButtonStyle}" Content="Duplicate" Command="{Binding DuplicatePlaylistCommand}" />
                                    <Button Grid.Column="2" Style="{StaticResource UtilityPillButtonStyle}" Content="Delete" Command="{Binding DeletePlaylistCommand}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource SecondaryHeroCardStyle}" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedPlaylistName}" Style="{StaticResource PanelTitleStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SelectedPlaylistCountText}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource UtilityPillButtonStyle}" Content="Rename" Click="RenamePlaylist_Click" ToolTip="Rename the selected playlist" />
                                        <Button Style="{StaticResource UtilityPillButtonStyle}" Content="Export" Command="{Binding ExportSelectedPlaylistCommand}" Margin="8,0,0,0" />
                                        <Button Style="{StaticResource UtilityPillButtonStyle}" Content="Load queue" Command="{Binding LoadPlaylistCommand}" Margin="8,0,0,0" />
                                        <Button Style="{StaticResource PrimaryPillButtonStyle}" Content="Play" Command="{Binding PlayPlaylistCommand}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,9" Margin="0,14,0,10">
                                    <TextBlock Text="Playlist order is preserved. Missing files stay in the saved playlist and are skipped when loaded." Style="{StaticResource CaptionStyle}" />
                                </Border>

                                <Grid Grid.Row="2">
                                    <ListBox ItemsSource="{Binding SelectedPlaylistTracks}" SelectedItem="{Binding SelectedPlaylistTrack}"
                                             Style="{StaticResource DarkListBoxStyle}" ItemContainerStyle="{StaticResource DarkListBoxItemStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" CornerRadius="9" Background="{DynamicResource AlbumArtPlaceholderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <Image Source="Assets/cadence-studio-icon-256.png" Width="22" Height="22" Opacity="0.5" />
                                                            <Border CornerRadius="8">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding ArtworkBytes, Converter={StaticResource AlbumArtConverter}}" Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                                                        <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Artist, Mode=OneWay}" /><Run Text=" • " /><Run Text="{Binding Album, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="10,0" />
                                                    <Button Grid.Column="3" Style="{StaticResource TreeActionButtonStyle}" Content="↑"
                                                            Command="{Binding DataContext.MovePlaylistTrackUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Move up" />
                                                    <Button Grid.Column="4" Style="{StaticResource TreeActionButtonStyle}" Content="↓"
                                                            Command="{Binding DataContext.MovePlaylistTrackDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Move down" />
                                                    <Button Grid.Column="5" Style="{StaticResource TreeActionButtonStyle}" Content="×"
                                                            Command="{Binding DataContext.RemovePlaylistTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Remove from playlist" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <Grid Grid.Row="3" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Use the P action in Library to add a track or complete folder branch to the selected playlist."
                                               Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Style="{StaticResource UtilityPillButtonStyle}" Content="Add current queue" Command="{Binding AddQueueToPlaylistCommand}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Queue management workspace -->
                    <Border Grid.Row="1" Style="{StaticResource SecondaryHeroCardStyle}" Padding="22"
                            Visibility="{Binding IsQueueActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Active queue" Style="{StaticResource PanelTitleStyle}" />
                                    <TextBlock Text="{Binding QueueVisibleCountText}" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                                </StackPanel>
                                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PrimaryPillButtonStyle}" Content="Open music" Command="{Binding OpenAudioFilesCommand}" />
                                    <Button Style="{StaticResource UtilityPillButtonStyle}" Content="Import M3U" Command="{Binding ImportPlaylistCommand}" Margin="8,0,0,0" />
                                    <Button Style="{StaticResource UtilityPillButtonStyle}" Content="Save playlist" Command="{Binding SaveQueueAsPlaylistCommand}" Margin="8,0,0,0" />
                                    <Button Style="{StaticResource UtilityPillButtonStyle}" Content="Export queue" Command="{Binding ExportQueueCommand}" Margin="8,0,0,0" />
                                    <Button Style="{StaticResource UtilityPillButtonStyle}" Content="Fetch artwork" Command="{Binding FetchQueueArtworkCommand}" Margin="8,0,0,0"
                                            ToolTip="Fetch missing MusicBrainz and Cover Art Archive artwork for the queue" />
                                    <Button Style="{StaticResource UtilityPillButtonStyle}" Content="Cancel artwork" Command="{Binding CancelQueueArtworkCommand}" Margin="8,0,0,0"
                                            Visibility="{Binding IsQueueArtworkLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Button Style="{StaticResource UtilityPillButtonStyle}" Content="Clear" Command="{Binding ClearQueueCommand}" Margin="8,0,0,0" />
                                </WrapPanel>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource SearchBoxStyle}" Margin="0,14,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="⌕" FontFamily="Segoe UI Symbol" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBox x:Name="QueueSearchTextBox" Grid.Column="1" Style="{StaticResource SearchTextBoxStyle}"
                                             Text="{Binding QueueSearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
                                    <TextBlock Grid.Column="1" Text="Search active queue…" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding QueueSearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding QueueArtworkStatus}" Style="{StaticResource CaptionStyle}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding QueueArtworkStatus}" />
                                    <TextBlock Grid.Column="1" Text="{Binding QueueArtworkMissingCountText}" Style="{StaticResource CaptionStyle}" Margin="12,0,0,0" />
                                </Grid>
                                <ProgressBar Grid.Row="1" Style="{StaticResource LibraryProgressBarStyle}" Margin="0,7,0,0"
                                             Maximum="{Binding QueueArtworkProgressMaximum, Mode=OneWay}"
                                             Value="{Binding QueueArtworkTracksProcessed, Mode=OneWay}"
                                             Visibility="{Binding IsQueueArtworkLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <Grid Grid.Row="3">
                                <ListBox x:Name="QueueManagerListBox" ItemsSource="{Binding QueueView}" SelectedItem="{Binding SelectedQueueTrack}"
                                         Style="{StaticResource DarkListBoxStyle}" ItemContainerStyle="{StaticResource DarkListBoxItemStyle}"
                                         AllowDrop="True" PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown"
                                         PreviewMouseLeftButtonUp="QueueList_PreviewMouseLeftButtonUp"
                                         PreviewMouseMove="QueueList_PreviewMouseMove"
                                         DragOver="QueueList_DragOver" Drop="QueueList_Drop">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="54" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="⋮⋮" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           ToolTip="Drag to reorder" Cursor="SizeAll" />
                                                <Border Grid.Column="1" Width="44" Height="44" CornerRadius="10" Background="{DynamicResource AlbumArtPlaceholderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Image Source="Assets/cadence-studio-icon-256.png" Width="24" Height="24" Opacity="0.5" />
                                                        <Border CornerRadius="9">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding ArtworkBytes, Converter={StaticResource AlbumArtConverter}}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                                                    <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Artist, Mode=OneWay}" /><Run Text=" • " /><Run Text="{Binding Album, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" Margin="12,0" />
                                                <Button Grid.Column="4" Style="{StaticResource TreeActionButtonStyle}" Content="↑"
                                                        Command="{Binding DataContext.MoveQueueTrackUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Move up" />
                                                <Button Grid.Column="5" Style="{StaticResource TreeActionButtonStyle}" Content="↓"
                                                        Command="{Binding DataContext.MoveQueueTrackDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Move down" />
                                                <Button Grid.Column="6" Style="{StaticResource TreeActionButtonStyle}" Content="▶"
                                                        Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Play track" />
                                                <Button Grid.Column="7" Style="{StaticResource TreeActionButtonStyle}" Content="×"
                                                        Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Remove from queue" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Queue.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="☷" FontFamily="Segoe UI Symbol" FontSize="30" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Your queue is empty" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,10,0,0" />
                                    <TextBlock Text="Open music, play a library folder, or load a saved playlist" Style="{StaticResource CaptionStyle}" Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="4" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Drag rows to reorder, or use the arrow controls. Search only filters the view and never changes playback order."
                                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource PrimaryPillButtonStyle}" Content="Play selected" Command="{Binding PlaySelectedCommand}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Settings and equalizer -->
