<Application x:Class="CadenceStudio.App.App"
             ShutdownMode="OnExplicitShutdown"
             Startup="App_StartupHealth"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CadenceStudio.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/EyeCandy.xaml" />
                <ResourceDictionary Source="Themes/CadenceMenus.xaml" />
                <ResourceDictionary Source="Themes/PremiumFoundation.xaml" />
                <ResourceDictionary Source="Themes/CadenceUniversal.xaml" />
                <ResourceDictionary Source="Themes/CadenceReadability.xaml" />
                <ResourceDictionary Source="Themes/CadenceRings.xaml" />
                <ResourceDictionary Source="Themes/CadenceQuickThemes.xaml" />
                <ResourceDictionary Source="Themes/CadenceVisualizerMenu.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ByteArrayToImageSourceConverter x:Key="AlbumArtConverter" />
            <converters:LibraryRowWidthConverter x:Key="LibraryRowWidthConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
