<Window x:Class="CadenceStudio.App.NowPlayingPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="482" Height="126" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Opacity="0" MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Window.Resources>
        <!-- Use the exact shared transport family used by the main player. -->
        <Style x:Key="PopupTransportButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
        </Style>
        <Style x:Key="PopupReactivePlayButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ReactivePlayTransportButtonStyle}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="PopupProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" Background="Transparent"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8" Padding="12,10" CornerRadius="17" Background="{DynamicResource PremiumCardBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect Color="#CC000000" BlurRadius="22" ShadowDepth="5" Opacity="0.48"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="142"/>
            </Grid.ColumnDefinitions>

            <Border Width="66" Height="66" CornerRadius="11" ClipToBounds="True"
                    Background="{DynamicResource AlbumArtPlaceholderBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Image Source="Assets/cadence-studio-icon-256.png"
                           Width="44" Height="44" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                    <Border>
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding NowPlayingArtwork, Converter={StaticResource AlbumArtConverter}}"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="NOW PLAYING" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                <TextBlock Text="{Binding NowPlayingTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding NowPlayingArtist}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding NowPlayingAlbum}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.82" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource PopupTransportButtonStyle}"
                        Command="{Binding PreviousCommand}" ToolTip="Previous"
                        AutomationProperties.Name="Previous track">
                    <TextBlock Text="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button Style="{StaticResource PopupReactivePlayButtonStyle}"
                        Command="{Binding TogglePlaybackCommand}" ToolTip="Play or pause"
                        AutomationProperties.Name="Play or pause" Margin="9,0">
                    <Grid Width="18" Height="18" IsHitTestVisible="False">
                        <Path Data="M 4,2 L 4,16 L 16,9 Z"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeLineJoin="Round">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaybackPlaying}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaybackPlaying}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Rectangle Width="4" Height="14" HorizontalAlignment="Left"
                                       Margin="3,0,0,0" RadiusX="1" RadiusY="1"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Rectangle Width="4" Height="14" HorizontalAlignment="Right"
                                       Margin="0,0,3,0" RadiusX="1" RadiusY="1"
                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Grid>
                </Button>
                <Button Style="{StaticResource PopupTransportButtonStyle}"
                        Command="{Binding NextCommand}" ToolTip="Next"
                        AutomationProperties.Name="Next track">
                    <TextBlock Text="&#xE893;" FontFamily="Segoe Fluent Icons" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>

            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource PopupProgressStyle}" Margin="0,8,0,0"
                         Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}"/>
        </Grid>
    </Border>
</Window>
