<Window x:Class="CadenceStudio.App.NowPlayingPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="482" Height="126" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        Opacity="0" MouseLeftButtonUp="Window_MouseLeftButtonUp">
    <Window.Resources>
        <Style x:Key="PopupTransportButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{DynamicResource PremiumButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                            <Ellipse x:Name="Face" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}"/>
                            <Ellipse Margin="4" Stroke="#32FFFFFF" StrokeThickness="1"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Fill" Value="{DynamicResource PremiumButtonHoverBrush}"/>
                                <Setter TargetName="Face" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Fill" Value="{DynamicResource PremiumButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track" Background="Transparent"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8" Padding="12,10" CornerRadius="17" Background="{DynamicResource PremiumCardBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.2">
        <Border.Effect>
            <DropShadowEffect Color="#CC000000" BlurRadius="22" ShadowDepth="5" Opacity="0.48"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="142"/>
            </Grid.ColumnDefinitions>

            <Border Width="66" Height="66" CornerRadius="11" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding NowPlayingArtwork, Converter={StaticResource AlbumArtConverter}}" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                <TextBlock Text="NOW PLAYING" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                <TextBlock Text="{Binding NowPlayingTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                <TextBlock Text="{Binding NowPlayingArtist}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"
                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding NowPlayingAlbum}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.82" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource PopupTransportButtonStyle}" Command="{Binding PreviousCommand}" ToolTip="Previous">
                    <Path Data="M 15,7 L 15,25 M 14,16 L 25,8 L 25,24 Z" Stroke="{DynamicResource TextPrimaryBrush}" Fill="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Stretch="Uniform" Width="15" Height="17"/>
                </Button>
                <Button Style="{StaticResource PopupTransportButtonStyle}" Command="{Binding TogglePlaybackCommand}" ToolTip="Play or pause" Margin="9,0">
                    <Grid Width="18" Height="18">
                        <Path Data="M 4,2 L 16,9 L 4,16 Z" Fill="{DynamicResource TextPrimaryBrush}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlayPauseGlyph}" Value="⏸"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        <DataTrigger Binding="{Binding PlayPauseGlyph}" Value="Ⅱ"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlayPauseGlyph}" Value="⏸"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding PlayPauseGlyph}" Value="Ⅱ"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Rectangle Width="5" Height="16" RadiusX="1" RadiusY="1" Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left"/>
                            <Rectangle Width="5" Height="16" RadiusX="1" RadiusY="1" Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                </Button>
                <Button Style="{StaticResource PopupTransportButtonStyle}" Command="{Binding NextCommand}" ToolTip="Next">
                    <Path Data="M 11,8 L 22,16 L 11,24 Z M 23,7 L 23,25" Stroke="{DynamicResource TextPrimaryBrush}" Fill="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Stretch="Uniform" Width="15" Height="17"/>
                </Button>
            </StackPanel>

            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource PopupProgressStyle}" Margin="0,8,0,0"
                         Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}"/>
        </Grid>
    </Border>
</Window>
