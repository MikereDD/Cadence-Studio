<Window x:Class="CadenceStudio.App.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="About Cadence Studio"
        Width="760" Height="760"
        MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        FontFamily="{DynamicResource AppBodyFontFamily}"
        FontSize="{DynamicResource AppBodyFontSize}"
        FontWeight="Medium"
        Foreground="{DynamicResource TextPrimaryBrush}"
        BorderThickness="0"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            CornerRadius="18"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Style="{StaticResource PremiumDialogChromeStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="18,18,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="About Cadence Studio" Style="{StaticResource SecondaryDialogTitleStyle}" Margin="18,0" />
                    <Button HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseWindowButtonStyle}" Content="Close" ContentTemplate="{StaticResource CadenceDialogCloseIconTemplate}" ToolTip="Close" AutomationProperties.Name="Close dialog" Click="Close_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="96" Height="96" CornerRadius="26" Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                            <Image Source="Assets/cadence-studio-icon-256.png" Margin="10" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Cadence Studio" FontFamily="{DynamicResource AppDisplayFontFamily}" FontSize="{DynamicResource AppDialogHeroFontSize}" FontWeight="Bold" />
                            <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0" />
                            <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="10,5" HorizontalAlignment="Left" Margin="0,12,0,0">
                                <TextBlock x:Name="ReleaseStageText" Text="DEVELOPMENT BUILD" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SecondaryWorkspaceCardStyle}" Margin="0,24,0,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Reliable. Functional. Polished. Eye Candy." Style="{StaticResource PanelTitleStyle}" />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"
                                       Text="A local-first Windows music player with library browsing, playlists, metadata tools, artwork, and customizable visualizers." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SecondaryWorkspaceCardStyle}" Margin="0,18,0,0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Updates" Style="{StaticResource PanelTitleStyle}" />
                                    <TextBlock x:Name="UpdatePolicyText"
                                               Text="v1.3 • Stable"
                                               Style="{StaticResource CaptionStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,16,0" />
                                </StackPanel>
                                <Button x:Name="UpdateCheckButton"
                                        Grid.Column="1"
                                        Style="{StaticResource AccentPillButtonStyle}"
                                        Content="Check for updates"
                                        Click="CheckForUpdates_Click"
                                        VerticalAlignment="Top" />
                            </Grid>


                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <Button x:Name="InstallButton" Content="Install update and restart"
                                        IsEnabled="False" Visibility="Collapsed" Click="Install_Click"
                                        Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,9" />
                                <TextBlock x:Name="UpdateStatusText" Text="Not checked yet." TextWrapping="Wrap"
                                           Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SecondaryWorkspaceCardStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Diagnostics and data" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock Text="Open support folders or copy a compact system and application report." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" Margin="0,6,0,14" />
                                <WrapPanel>
                                    <Button Style="{StaticResource PillButtonStyle}" Content="Open logs" Click="OpenLogs_Click" Margin="0,0,8,8" />
                                    <Button Style="{StaticResource PillButtonStyle}" Content="Open cache" Click="OpenCache_Click" Margin="0,0,8,8" />
                                    <Button Style="{StaticResource PillButtonStyle}" Content="Open data" Click="OpenData_Click" Margin="0,0,8,8" />
                                    <Button Style="{StaticResource AccentPillButtonStyle}" Content="Copy diagnostics" Click="CopyDiagnostics_Click" Margin="0,0,8,8" />
                                </WrapPanel>
                                <ToggleButton x:Name="UpdaterToolsToggle" Content="Updater diagnostics"
                                              Style="{StaticResource ChipToggleStyle}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding IsChecked, ElementName=UpdaterToolsToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Test updater handoff without installing an update."
                                               Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <Button x:Name="DryRunButton" Content="Test updater (no installation)"
                                            Click="DryRun_Click" Style="{StaticResource PillButtonStyle}"
                                            HorizontalAlignment="Left" Margin="0,8,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="DiagnosticsStatusText" Text="Ready" Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource SecondaryWorkspaceCardStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Credits and licenses" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="19"
                                           Text="Built with .NET, WPF, NAudio, and TagLibSharp. Metadata and enrichment use MusicBrainz, Cover Art Archive, LRCLIB, and Wikimedia services." />
                                <Button Style="{StaticResource PillButtonStyle}" Content="View third-party notices" Click="ViewNotices_Click"
                                        HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Typezer∅ Studio" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" Margin="0,24,0,6" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
