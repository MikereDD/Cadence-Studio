<Window x:Class="CadenceStudio.App.AlbumMetadataWorkshopDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Album Metadata Workshop" Width="1240" Height="820" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource AppBodyFontFamily}" FontSize="{DynamicResource AppBodyFontSize}"
        FontWeight="Medium" ShowInTaskbar="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style x:Key="WorkshopComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource PremiumComboBoxStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontFamily" Value="{DynamicResource AppBodyFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppBodyFontSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboShell"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="SelectedContent"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      IsHitTestVisible="False" />
                                    <TextBlock x:Name="LoadingPlaceholder"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Text="Loading release candidates…"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold"
                                               Visibility="Collapsed"
                                               IsHitTestVisible="False" />
                                    <Border Grid.Column="1" Margin="0,4,4,4" CornerRadius="10"
                                            Background="{DynamicResource PremiumCardBrush}"
                                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                        <TextBlock Text="⌄" FontFamily="Segoe UI Symbol" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent" BorderThickness="0" Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="440"
                                        Margin="0,7,0,0"
                                        Background="{DynamicResource PremiumMenuBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="15" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="8" Opacity="0.78" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="3" CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="{DynamicResource ControlActiveBrush}" />
                                <Setter TargetName="ComboShell" Property="Background" Value="{DynamicResource PremiumButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ComboShell" Property="Background" Value="{DynamicResource PremiumButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="SelectedContent" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="LoadingPlaceholder" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ComboShell" Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboShell" Property="Background" Value="{DynamicResource PremiumButtonBrush}" />
                                <Setter TargetName="ComboShell" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource WindowDepthBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderSoftBrush}"/>
            <Setter Property="RowBackground" Value="{DynamicResource WindowBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="18" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border Style="{StaticResource PremiumDialogChromeStyle}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" CornerRadius="18,18,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                        <TextBlock Text="Album Metadata Workshop" FontSize="14" FontWeight="Bold"/>
                        <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="12,0,0,0"><TextBlock Text="SAFE BATCH REVIEW" FontSize="9" FontWeight="Bold"/></Border>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseWindowButtonStyle}" Content="×" Click="Close_Click"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource SecondaryWorkspaceCardStyle}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="60" Height="60" CornerRadius="10" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <Image x:Name="ArtworkImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="AlbumFolderText" FontFamily="{DynamicResource AppDisplayFontFamily}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="AlbumPathText" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            <TextBlock x:Name="ReleaseSummaryText" FontWeight="SemiBold" Margin="0,7,12,0" TextWrapping="Wrap"/>
                            <TextBlock Text="MusicBrainz release candidate" Style="{StaticResource CaptionStyle}" Margin="0,8,12,4"/>
                            <ComboBox x:Name="ReleaseCandidateBox"
                                      Style="{StaticResource WorkshopComboBoxStyle}"
                                      MinWidth="500" MaxWidth="760" HorizontalAlignment="Left"
                                      IsEditable="False"
                                      TextSearch.TextPath="DisplayLabel"
                                      DisplayMemberPath="DisplayLabel"
                                      SelectionChanged="ReleaseCandidateBox_SelectionChanged">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource PremiumComboBoxItemStyle}" />
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <TextBlock x:Name="ScanSummaryText" Style="{StaticResource CaptionStyle}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button x:Name="RefreshProposalButton" Style="{StaticResource PillButtonStyle}" Content="Reload selected release + artwork" Click="Refresh_Click" Margin="0,0,0,8"/>
                            <Button x:Name="ApplyReleaseButton" Style="{StaticResource AccentPillButtonStyle}" Content="Apply release to album" Click="ApplyRelease_Click" Margin="0,0,0,8"/>
                            <Button Style="{StaticResource PillButtonStyle}" Content="Restore local values" Click="RestoreLocal_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource SecondaryWorkspaceCardStyle}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/><ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Album" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="AlbumBox" Grid.Column="1" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="Album artist" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="AlbumArtistBox" Grid.Column="4" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="6" Text="Year" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="YearBox" Grid.Column="7" Margin="8,0,0,0"/>
                        <TextBlock Grid.Column="9" Text="Genre" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox x:Name="GenreBox" Grid.Column="10" Margin="8,0,0,0"/>
                        <CheckBox x:Name="EmbedArtworkCheck" Style="{StaticResource PremiumAuditCheckBoxStyle}" Grid.Column="12" Content="Embed artwork in every selected file" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource SecondaryWorkspaceCardStyle}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Album track review" Style="{StaticResource PanelTitleStyle}"/>
                                <TextBlock Text="Uncheck tracks you do not want to modify. Titles and track numbers remain individually editable." Style="{StaticResource CaptionStyle}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PillButtonStyle}" Content="Select all" Click="SelectAll_Click" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource PillButtonStyle}" Content="Select none" Click="SelectNone_Click"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid x:Name="TracksGrid" Style="{StaticResource PremiumAuditDataGridStyle}" Grid.Row="2" ItemsSource="{Binding AlbumRows, RelativeSource={RelativeSource AncestorType=Window}}" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Write" Binding="{Binding IsSelected}" Width="56"/>
                                <DataGridTextColumn Header="#" Binding="{Binding ProposedTrackNumber, UpdateSourceTrigger=PropertyChanged}" Width="54"/>
                                <DataGridTextColumn Header="Title" Binding="{Binding ProposedTitle, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                <DataGridTextColumn Header="Artist" Binding="{Binding ProposedArtist, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                                <DataGridTextColumn Header="Current" Binding="{Binding CurrentSummary}" IsReadOnly="True" Width="1.6*"/>
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" IsReadOnly="True" Width="2*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="1.1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource PillButtonStyle}" Content="Cancel" Click="Close_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AccentPillButtonStyle}" Content="Back up, write album, and verify" Click="WriteAlbum_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
